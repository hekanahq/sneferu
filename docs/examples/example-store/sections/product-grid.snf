<hk-section padding-y="64" mobile-padding-y="40">
  <hk-stack gap="24">
    <hk-stack direction="row" justify="between" align="center">
      <hk-heading text="{{ section.settings.heading }}" level="h2" size="32" mobile-size="24" />
      {% if section.settings.show_link %}
        <hk-button label="{{ t('view_all') }}" href="/collections/featured" variant="ghost" />
      {% endif %}
    </hk-stack>
    {% if collection('featured').products %}
      <hk-product-grid
        products="{{ collection('featured').products }}"
        limit="{{ section.settings.count }}"
        columns="4"
        tablet-columns="3"
        mobile-columns="2"
      />
    {% else %}
      <hk-text text="{{ t('collection_empty') }}" align="center" />
    {% endif %}
  </hk-stack>
</hk-section>
<hk-schema>
  {
    "name": "Product grid",
    "version": 1,
    "settings": {
      "heading": {
        "type": "text",
        "label": "Heading",
        "default": "Best sellers"
      },
      "count": {
        "type": "range",
        "label": "Products to show",
        "default": 4,
        "min": 2,
        "max": 24,
        "step": 1
      },
      "show_link": {
        "type": "boolean",
        "label": "Show “View all”",
        "default": true
      }
    }
  }
</hk-schema>
