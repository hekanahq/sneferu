{
  "name": "sneferu-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "changeset": "changeset",
    "smoke:cjs": "node scripts/smoke-cjs.cjs",
    "release": "pnpm build && changeset publish",
    "docs:tags": "pnpm --filter @hekana/sneferu-core build && tsx scripts/gen-tag-docs.ts",
    "docs:shots": "pnpm build && tsx scripts/docs-shots.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "playwright-core": "1.58.2",
    "sharp": "0.34.5",
    "tsup": "^8.3.5",
    "tsx": "^4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
