<header class="sf-header sf-scheme-{{ section.settings.scheme }} sf-sticky-{{ section.settings.sticky }}">
  <hk-container>
    <div class="sf-header-bar">
      <a class="sf-logo" href="{{ url('/') }}">
        {% if section.settings.logo %}
          <img
            class="sf-logo-img sf-logo-h-{{ section.settings.logo_height }}"
            src="{{ section.settings.logo }}"
            alt="{{ store.name }}"
            width="160"
            height="{{ section.settings.logo_height }}"
          >
        {% endif %}
        {% if section.settings.logo_text %}
          <span class="sf-logo-text">{{ section.settings.logo_text }}</span>
        {% elsif section.settings.logo == '' %}
          <span class="sf-logo-text">{{ store.name }}</span>
        {% endif %}
      </a>
      <nav class="sf-nav" aria-label="{{ t('menu') }}">
        {% if menu(section.settings.menu).items %}
          {% for item in menu(section.settings.menu).items %}
            <div class="sf-nav-item">
              <a class="sf-nav-link" href="{{ item.url }}" aria-current="{{ item.active }}">{{ item.title }}</a>
              {% if item.children %}
                <div class="sf-subnav">
                  {% for sub in item.children %}
                    <a class="sf-subnav-link" href="{{ sub.url }}" aria-current="{{ sub.active }}">{{ sub.title }}</a>
                    {% for leaf in sub.children %}
                      <a
                        class="sf-subnav-link sf-subnav-deep"
                        href="{{ leaf.url }}"
                        aria-current="{{ leaf.active }}"
                      >{{ leaf.title }}</a>
                    {% endfor %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}{% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}{% endif %}
      </nav>
      <div class="sf-header-actions">
        {% if section.settings.show_search %}
          <details class="sf-search-toggle">
            <summary class="sf-icon-button" aria-label="{{ t('search') }}"><hk-icon name="search" /></summary>
            <div class="sf-search-panel"><hk-search-form placeholder="{{ t('search_placeholder') }}" /></div>
          </details>
        {% endif %}
        {% if section.settings.show_language %}<hk-locale-switch />{% endif %}
        {% if section.settings.show_cart %}
          <a
            class="sf-icon-button sf-cart-link"
            href="{{ url('/cart') }}"
            data-hk-open="cart-drawer"
            aria-label="{{ t('cart') }}"
          >
            <hk-icon name="shopping-cart" />
            <hk-cart-count />
          </a>
        {% endif %}
      </div>
    </div>
  </hk-container>
  {% if section.settings.show_cart %}
    <hk-cart-drawer open-on-add="{{ section.settings.drawer_on_add }}">
      <hk-cart-items />
      <hk-cart-summary />
    </hk-cart-drawer>
  {% endif %}
</header>
<hk-schema>
  {
    "name": {
      "en": "Header",
      "ar": "الهيدر"
    },
    "version": 1,
    "templates": ["header"],
    "blocks": {
      "allowed": ["menu-link"],
      "max": 8
    },
    "settings": {
      "menu": {
        "type": "menu",
        "label": {
          "en": "Menu (the links below show when none is picked or it has no links)",
          "ar": "القائمة (الروابط اللي تحت بتظهر لو مفيش قائمة أو مفيهاش روابط)"
        },
        "default": ""
      },
      "logo": {
        "type": "image",
        "label": {
          "en": "Logo image",
          "ar": "صورة الشعار"
        },
        "default": ""
      },
      "logo_text": {
        "type": "text",
        "label": {
          "en": "Logo text (store name when empty)",
          "ar": "نص الشعار (اسم المتجر لو فاضي)"
        },
        "default": "",
        "localized": true,
        "maxLength": 40
      },
      "logo_height": {
        "type": "select",
        "label": {
          "en": "Logo height (px)",
          "ar": "ارتفاع الشعار (بكسل)"
        },
        "options": ["24", "32", "40", "48", "64"],
        "default": "40"
      },
      "scheme": {
        "type": "select",
        "label": {
          "en": "Colour scheme",
          "ar": "ألوان الهيدر"
        },
        "options": ["light", "primary", "accent"],
        "default": "light"
      },
      "sticky": {
        "type": "boolean",
        "label": {
          "en": "Stick to the top",
          "ar": "تثبيت في أعلى الصفحة"
        },
        "default": false
      },
      "show_search": {
        "type": "boolean",
        "label": {
          "en": "Show search",
          "ar": "إظهار البحث"
        },
        "default": true
      },
      "show_language": {
        "type": "boolean",
        "label": {
          "en": "Show language switch",
          "ar": "إظهار تبديل اللغة"
        },
        "default": true
      },
      "show_cart": {
        "type": "boolean",
        "label": {
          "en": "Show cart",
          "ar": "إظهار السلة"
        },
        "default": true
      },
      "drawer_on_add": {
        "type": "boolean",
        "label": {
          "en": "Open the cart when an item is added",
          "ar": "فتح السلة عند الإضافة"
        },
        "default": true,
        "visible_if": {
          "setting": "show_cart",
          "equals": true
        }
      }
    }
  }
</hk-schema>
