<hk-combined-listing product="{{ product }}" display="{{ block.settings.style }}" />
<hk-schema>
  {
    "name": {
      "en": "Combined listing",
      "ar": "منتجات مجمّعة"
    },
    "version": 1,
    "settings": {
      "style": {
        "type": "select",
        "label": {
          "en": "Style",
          "ar": "الشكل"
        },
        "options": ["auto", "swatches", "buttons", "select"],
        "default": "auto"
      }
    }
  }
</hk-schema>
