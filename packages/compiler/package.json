{
  "name": "@hekana/sneferu-compiler",
  "version": "0.5.1",
  "description": "Sneferu compiler: templates to IR",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@hekana/sneferu-core": "workspace:^",
    "@hekana/sneferu-templates-default": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://hekana.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hekanahq/sneferu.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/hekanahq/sneferu/issues"
  },
  "author": "Hekana"
}
