{
  "name": "@hekana/sneferu",
  "version": "0.8.0",
  "description": "Sneferu — build Hekana themes. npx sneferu init",
  "type": "module",
  "bin": {
    "sneferu": "./dist/cli.js",
    "snf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/copy-templates.mjs && tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hekana/sneferu-compiler": "workspace:^",
    "@hekana/sneferu-runtime": "workspace:^",
    "@hekana/sneferu-components": "workspace:^",
    "@hekana/sneferu-core": "workspace:^",
    "@hekana/prettier-plugin-sneferu": "workspace:^",
    "prettier": "^3.6.2",
    "commander": "^12.1.0",
    "chokidar": "^4.0.1",
    "@hekana/sneferu-templates-default": "workspace:^",
    "@hekana/sneferu-controllers": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://hekana.dev",
  "repository": {
    "type": "git",
