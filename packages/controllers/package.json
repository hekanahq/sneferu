{
  "name": "@hekana/sneferu-controllers",
  "version": "0.7.0",
  "description": "Sneferu controllers: the vetted client runtime for variant picker, add to cart, cart drawer and cart rendering",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://hekana.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hekanahq/sneferu.git",
    "directory": "packages/controllers"
  },
  "bugs": {
    "url": "https://github.com/hekanahq/sneferu/issues"
  },
  "author": "Hekana"
}
