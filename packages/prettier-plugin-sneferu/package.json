{
  "name": "@hekana/prettier-plugin-sneferu",
  "version": "0.6.0",
  "description": "Prettier plugin for Sneferu theme files (.snf, .sneferu)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "sneferu",
    "hekana",
    "theme"
  ],
  "license": "MIT",
  "dependencies": {
    "@hekana/sneferu-compiler": "workspace:^"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@hekana/sneferu-components": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://hekana.dev/guide/format-your-theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hekanahq/sneferu.git",
    "directory": "packages/prettier-plugin-sneferu"
  },
  "bugs": {
    "url": "https://github.com/hekanahq/sneferu/issues"
  },
  "author": "Hekana"
}
