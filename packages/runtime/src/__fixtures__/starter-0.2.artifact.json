   "ar": "Starter",
   "en": "Starter"
  },
  "version": "0.1.0",
  "author": "Hekana",
  "description": {
   "ar": "A starting point for a Sneferu theme",
   "en": "A starting point for a Sneferu theme"
  },
  "category": "general",
  "engine": "hk2",
  "engineCompatibility": "^2.0.0",
  "defaultLocale": "en",
  "locales": [
   "en",
   "ar"
  ],
  "settings": {
