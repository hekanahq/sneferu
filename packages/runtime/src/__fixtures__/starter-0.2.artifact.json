      {
       "k": "comp",
       "tag": "hk-text",
       "props": {
        "text": {
         "k": "expr",
         "e": {
          "k": "path",
          "p": [
           "store",
           "name"
          ]
         }
        },
        "size": {
         "k": "responsive",
         "base": {
          "k": "static",
          "v": 14
         }
        }
       },
       "children": []
      }
     ]
    }
   ]
  }
 ],
 "templates": {
