     "en": "Accent"
    },
    "default": "#B45309"
   }
  },
  "tokens": {
   "colors": {
    "primary": "#111827",
    "secondary": "#1F2937",
    "accent": "#B45309",
    "background": "#FFFFFF",
    "text": "#111827"
   },
   "layout": {
    "contentWidth": "1200px"
   }
  }
 },
 "layout": [
  {
   "k": "el",
   "tag": "header",
