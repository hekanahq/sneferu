      "site-header"
     ]
    }
   ],
   "children": [
    {
     "k": "comp",
     "tag": "hk-container",
     "props": {},
     "children": [
      {
       "k": "el",
       "tag": "a",
       "attrs": [
        {
         "name": "href",
         "sink": "url",
         "parts": [
          "/"
         ]
        },
        {
         "name": "class",
         "sink": "token",
         "parts": [
          "logo"
         ]
        }
       ],
       "children": [
        {
         "k": "text",
         "e": {
          "k": "path",
          "p": [
           "store",
           "name"
          ]
         }
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "k": "el",
   "tag": "main",
   "attrs": [],
