    {
     "k": "slot",
     "name": "content"
    }
   ]
  },
  {
   "k": "el",
   "tag": "footer",
   "attrs": [
    {
     "name": "class",
     "sink": "token",
     "parts": [
      "site-footer"
     ]
    }
   ],
   "children": [
    {
     "k": "comp",
     "tag": "hk-container",
     "props": {},
