{
  "name": "@hekana/sneferu-runtime",
  "version": "0.1.0",
  "description": "Sneferu runtime: render IR to HTML",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "license": "SEE LICENSE IN ../../LICENSE",
  "dependencies": {
    "@hekana/sneferu-core": "workspace:^"
  }
}
