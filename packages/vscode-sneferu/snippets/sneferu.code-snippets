{
 "Section with schema": {
  "prefix": [
   "section",
   "hk-section"
  ],
  "description": "A section file: markup and its <hk-schema>.",
  "body": [
   "<hk-section padding-y=\"${1:64}\" mobile-padding-y=\"${2:40}\">",
   "\t<hk-container>",
   "\t\t<hk-heading text=\"{{ section.settings.heading }}\" level=\"h2\" />",
   "\t\t$0",
   "\t</hk-container>",
   "</hk-section>",
   "<hk-schema>",
   "\t{",
   "\t\t\"name\": { \"en\": \"${3:Section name}\", \"ar\": \"${4}\" },",
   "\t\t\"version\": 1,",
   "\t\t\"settings\": {",
   "\t\t\t\"heading\": { \"type\": \"text\", \"label\": { \"en\": \"Heading\" }, \"default\": \"${5:Heading}\", \"maxLength\": 80 }",
   "\t\t}",
   "\t}",
   "</hk-schema>"
  ]
 },
 "Section with blocks": {
  "prefix": [
   "section-blocks"
  ],
  "description": "A section that renders its blocks.",
  "body": [
   "<hk-section>",
   "\t<hk-container>",
   "\t\t<hk-grid columns=\"${1:3}\" mobile-columns=\"1\" gap=\"24\">",
   "\t\t\t{% for block in section.blocks %}",
   "\t\t\t\t<hk-block of=\"{{ block }}\" />",
   "\t\t\t{% endfor %}",
   "\t\t</hk-grid>",
   "\t</hk-container>",
   "</hk-section>",
   "<hk-schema>",
   "\t{",
   "\t\t\"name\": { \"en\": \"${2:Section name}\" },",
   "\t\t\"version\": 1,",
   "\t\t\"blocks\": { \"allowed\": [\"${3:block-type}\"], \"max\": ${4:6} },",
   "\t\t\"settings\": {}",
   "\t}",
   "</hk-schema>"
  ]
 },
 "Schema": {
  "prefix": [
   "schema",
   "hk-schema"
  ],
  "description": "<hk-schema> with one setting.",
  "body": [
   "<hk-schema>",
   "\t{",
   "\t\t\"name\": { \"en\": \"${1:Name}\" },",
   "\t\t\"version\": 1,",
   "\t\t\"settings\": {",
   "\t\t\t\"${2:key}\": { \"type\": \"${3|text,textarea,rich_text,number,range,boolean,select,color,image,video,link,icon,product,collection|}\", \"label\": { \"en\": \"${4:Label}\" }, \"default\": ${5:\"\"} }",
   "\t\t}",
   "\t}",
   "</hk-schema>"
  ]
 },
 "Setting": {
  "prefix": [
   "setting"
  ],
  "description": "One schema setting.",
  "body": [
   "\"${1:key}\": { \"type\": \"${2|text,textarea,rich_text,number,range,boolean,select,color,image,video,link,icon,product,collection|}\", \"label\": { \"en\": \"${3:Label}\", \"ar\": \"${4}\" }, \"default\": ${5:\"\"} }"
  ]
 },
 "Template default sections": {
  "prefix": [
   "template-schema"
  ],
  "description": "A template's default sections.",
  "body": [
   "<hk-sections />",
   "<hk-schema>",
   "\t{",
   "\t\t\"sections\": [",
   "\t\t\t{ \"type\": \"${1:hero}\", \"settings\": {} }",
   "\t\t]",
   "\t}",
   "</hk-schema>"
  ]
 },
 "if": {
  "prefix": [
   "if",
   "{% if"
  ],
  "description": "{% if %} … {% endif %}",
  "body": [
   "{% if ${1:condition} %}",
   "\t$0",
   "{% endif %}"
  ]
 },
 "if else": {
  "prefix": [
   "ifelse",
   "{% if else"
  ],
  "description": "{% if %} … {% else %} … {% endif %}",
  "body": [
   "{% if ${1:condition} %}",
   "\t$2",
   "{% else %}",
   "\t$0",
   "{% endif %}"
  ]
 },
 "for": {
  "prefix": [
   "for",
   "{% for"
  ],
  "description": "{% for x in … %} … {% endfor %}",
  "body": [
   "{% for ${1:product} in ${2:collection('${3:featured}').products} limit: ${4:8} %}",
   "\t$0",
   "{% endfor %}"
  ]
 },
 "for blocks": {
  "prefix": [
   "blocks",
   "for-blocks"
  ],
  "description": "Render the section's blocks.",
  "body": [
   "{% for block in section.blocks %}",
   "\t<hk-block of=\"{{ block }}\" />",
   "{% endfor %}"
  ]
 },
 "render": {
  "prefix": [
   "render",
   "{% render"
  ],
  "description": "Render a snippet.",
  "body": [
   "{% render '${1:snippet}'${2:, ${3:key}: ${4:value}} %}"
  ]
 },
 "output": {
  "prefix": [
   "{{",
   "out"
  ],
  "description": "Output an expression.",
  "body": [
   "{{ ${1:section.settings.heading} }}"
  ]
 },
 "translation": {
  "prefix": [
   "t",
   "trans"
  ],
  "description": "A translated string.",
  "body": [
   "{{ t('${1:key}') }}"
  ]
 },
 "product grid": {
  "prefix": [
   "product-grid",
   "hk-product-grid"
  ],
  "description": "Products of a collection.",
  "body": [
   "<hk-product-grid products=\"{{ collection('${1:featured}').products }}\" limit=\"${2:8}\" columns=\"${3:4}\" tablet-columns=\"2\" mobile-columns=\"2\" />"
  ]
 },
 "image": {
  "prefix": [
   "image",
   "hk-image"
  ],
  "description": "An image with alt text.",
  "body": [
   "<hk-image src=\"{{ ${1:section.settings.image} }}\" alt=\"${2:{{ section.settings.alt \\}\\}}\" aspect-ratio=\"${3|1/1,4/5,3/4,16/9,21/9|}\" />"
  ]
 },
 "layout": {
  "prefix": [
   "layout"
  ],
  "description": "layout/theme.snf skeleton.",
  "body": [
   "<header class=\"site-header\">",
   "\t<hk-container><a href=\"/\">{{ store.name }}</a></hk-container>",
   "</header>",
   "<main><hk-slot name=\"content\" /></main>",
   "<footer class=\"site-footer\">",
   "\t<hk-container><hk-text text=\"{{ store.name }}\" size=\"14\" /></hk-container>",
   "</footer>"
  ]
 }
}