<div class="dk-price-row">
  {% render 'price', product: product, bind: true %}
  {% if block.settings.show_badge %}
    {% if product.available %}
      {% if product.compare_at > product.price %}<span class="dk-badge">{{ t('sale') }}</span>{% endif %}
    {% else %}
      <span class="dk-badge dk-badge-muted">{{ t('sold_out_badge') }}</span>
    {% endif %}
  {% endif %}
</div>
<hk-schema>
  {
    "name": {
      "en": "Price",
      "ar": "السعر"
    },
    "version": 1,
    "settings": {
      "show_badge": {
        "type": "boolean",
        "label": {
          "en": "Show sale and sold out badge",
          "ar": "إظهار شارة الخصم ونفاد المخزون"
        },
        "default": true
      }
    }
  }
</hk-schema>
