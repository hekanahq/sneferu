{% if block.settings.url %}<a href="{{ url(block.settings.url) }}">{{ block.settings.label }}</a>{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Footer link",
      "ar": "رابط في الفوتر"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Label",
          "ar": "النص"
        },
        "default": {
          "ar": "رابط",
          "en": "Link"
        },
        "localized": true,
        "maxLength": 40
      },
      "url": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/"
      }
    }
  }
</hk-schema>
