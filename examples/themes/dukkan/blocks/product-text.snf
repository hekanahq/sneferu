{% if block.settings.text %}
  <p class="dk-note dk-note-{{ block.settings.tone }}">
    {% if block.settings.icon != 'none' %}<hk-icon name="{{ block.settings.icon }}" />{% endif %}
    <span>{{ block.settings.text }}</span>
  </p>
{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Text note",
      "ar": "ملاحظة"
    },
    "version": 1,
    "settings": {
      "text": {
        "type": "textarea",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "default": {
          "ar": "الدفع عند الاستلام.",
          "en": "Cash on delivery."
        },
        "localized": true,
        "maxLength": 200
      },
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["none", "banknote", "truck", "package", "shield-check", "clock", "gift", "lock", "mail"],
        "default": "banknote"
      },
      "tone": {
        "type": "select",
        "label": {
          "en": "Look",
          "ar": "الشكل"
        },
        "options": ["plain", "muted"],
        "default": "muted"
      }
    }
  }
</hk-schema>
