{% if block.settings.url %}<a
    class="dk-social"
    href="{{ url(block.settings.url) }}"
    aria-label="{{ block.settings.label }}"
  >
    <hk-icon name="{{ block.settings.icon }}" />
    <span>{{ block.settings.label }}</span>
  </a>{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Social link",
      "ar": "رابط تواصل اجتماعي"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Name",
          "ar": "الاسم"
        },
        "default": {
          "ar": "إنستجرام",
          "en": "Instagram"
        },
        "localized": true,
        "maxLength": 30
      },
      "url": {
        "type": "link",
        "label": {
          "en": "Link (hidden when empty)",
          "ar": "الرابط (بيختفي لو فاضي)"
        },
        "default": ""
      },
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["share-2", "link", "message-circle", "globe", "mail", "external-link"],
        "default": "share-2"
      }
    }
  }
</hk-schema>
