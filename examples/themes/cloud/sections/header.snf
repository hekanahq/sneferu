<header class="cl-header cl-scheme-{{ section.settings.scheme }} cl-sticky-{{ section.settings.sticky }}">
  <hk-container>
    <div class="cl-header-bar">
      <a class="cl-logo" href="{{ url('/') }}">
        {% if section.settings.logo %}
          <img
            class="cl-logo-img cl-logo-h-{{ section.settings.logo_height }}"
            src="{{ section.settings.logo }}"
            alt="{{ store.name }}"
            width="160"
            height="{{ section.settings.logo_height }}"
          >
        {% else %}
          {% render 'mark' %}
        {% endif %}
        {% if section.settings.logo_text %}
          <span class="cl-logo-text">{{ section.settings.logo_text }}</span>
        {% elsif section.settings.logo == '' %}
          <span class="cl-logo-text">{{ store.name }}</span>
        {% endif %}
      </a>
      <div class="cl-header-search">
        {% if section.settings.show_search %}<hk-search-form placeholder="{{ t('search_placeholder') }}" />{% endif %}
      </div>
      <div class="cl-header-actions">
        {% if section.settings.show_language %}<span class="cl-hide-sm"><hk-locale-switch /></span>{% endif %}
        {% if section.settings.show_account %}
          <a class="cl-icon-button cl-hide-sm" href="{{ url('/account') }}" aria-label="{{ t('account') }}"><hk-icon
              name="user"
            /></a>
        {% endif %}
        {% if section.settings.show_cart %}
          <a
            class="cl-icon-button cl-cart-link"
            href="{{ url('/cart') }}"
            data-hk-open="cart-drawer"
            aria-label="{{ t('cart') }}"
          >
            <hk-icon name="shopping-bag" />
            <hk-cart-count />
          </a>
        {% endif %}
      </div>
    </div>
    {% if menu(section.settings.menu).items %}
      <nav class="cl-nav" aria-label="{{ t('menu') }}">
        {% for item in menu(section.settings.menu).items %}
          <a class="cl-nav-link" href="{{ item.url }}" aria-current="{{ item.active }}">{{ item.title }}</a>
        {% endfor %}
      </nav>
    {% else %}
      {% if section.blocks %}
        <nav class="cl-nav" aria-label="{{ t('menu') }}">
          {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
        </nav>
      {% endif %}
    {% endif %}
  </hk-container>
  <div class="cl-wave cl-wave-light cl-header-wave">
    {% render 'wave' %}
  </div>
  {% if section.settings.show_cart %}
    <hk-cart-drawer open-on-add="{{ section.settings.drawer_on_add }}">
      <hk-cart-items />
      <hk-cart-summary />
    </hk-cart-drawer>
  {% endif %}
</header>
<hk-schema>
  {
    "name": {
      "en": "Header",
      "ar": "الهيدر"
    },
    "version": 1,
    "templates": ["header"],
    "blocks": {
      "allowed": ["menu-link"],
      "max": 8
    },
    "settings": {
      "menu": {
        "type": "menu",
        "label": {
          "en": "Menu (shown under the bar; the links below are used when none is picked)",
          "ar": "القائمة (بتظهر تحت الشريط؛ الروابط اللي تحت بتتستخدم لو مفيش قائمة)"
        },
        "default": ""
      },
      "logo": {
        "type": "image",
        "label": {
          "en": "Logo image",
          "ar": "صورة الشعار"
        },
        "default": ""
      },
      "logo_text": {
        "type": "text",
        "label": {
          "en": "Logo text (store name when empty)",
          "ar": "نص الشعار (اسم المتجر لو فاضي)"
        },
        "default": "",
        "localized": true,
        "maxLength": 40
      },
      "logo_height": {
        "type": "select",
        "label": {
          "en": "Logo height (px)",
          "ar": "ارتفاع الشعار (بكسل)"
        },
        "options": ["24", "32", "40", "48", "64"],
        "default": "40"
      },
      "scheme": {
        "type": "select",
        "label": {
          "en": "Colour scheme",
          "ar": "ألوان الهيدر"
        },
        "options": ["butter", "sky", "mint", "light"],
        "default": "butter"
      },
      "sticky": {
        "type": "boolean",
        "label": {
          "en": "Stick to the top",
          "ar": "تثبيت في أعلى الصفحة"
        },
        "default": false
      },
      "show_search": {
        "type": "boolean",
        "label": {
          "en": "Show search",
          "ar": "إظهار البحث"
        },
        "default": true
      },
      "show_account": {
        "type": "boolean",
        "label": {
          "en": "Show account icon",
          "ar": "إظهار أيقونة الحساب"
        },
        "default": true
      },
      "show_language": {
        "type": "boolean",
        "label": {
          "en": "Show language switch",
          "ar": "إظهار تبديل اللغة"
        },
        "default": true
      },
      "show_cart": {
        "type": "boolean",
        "label": {
          "en": "Show cart",
          "ar": "إظهار السلة"
        },
        "default": true
      },
      "drawer_on_add": {
        "type": "boolean",
        "label": {
          "en": "Open the cart when an item is added",
          "ar": "فتح السلة عند الإضافة"
        },
        "default": true,
        "visible_if": {
          "setting": "show_cart",
          "equals": true
        }
      }
    }
  }
</hk-schema>
