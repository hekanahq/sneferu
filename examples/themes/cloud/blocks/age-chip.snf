<a
  class="cl-age-chip"
  href="{{ url(block.settings.link) }}"
  aria-label="{{ t('age_label') }} {{ block.settings.label }}"
>{{ block.settings.label }}</a>
<hk-schema>
  {
    "name": {
      "en": "Age chip",
      "ar": "شريحة عمر"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Age range",
          "ar": "الفئة العمرية"
        },
        "localized": true,
        "default": {
          "ar": "0-2",
          "en": "0-2"
        },
        "maxLength": 12
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/products"
      }
    }
  }
</hk-schema>
