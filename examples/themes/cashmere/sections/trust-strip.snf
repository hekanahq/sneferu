<div class="ca-trust">
  <hk-container>
    <div class="ca-trust-row">
      {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
    </div>
  </hk-container>
</div>
<hk-schema>
  {
    "name": {
      "en": "Trust strip",
      "ar": "شريط الثقة"
    },
    "version": 1,
    "blocks": {
      "allowed": ["trust-item"],
      "max": 5
    },
    "settings": {},
    "presets": [
      {
        "name": {
          "en": "Three points",
          "ar": "ثلاث نقاط"
        },
        "blocks": [
          {
            "type": "trust-item"
          },
          {
            "type": "trust-item"
          },
          {
            "type": "trust-item"
          }
        ]
      }
    ]
  }
</hk-schema>
