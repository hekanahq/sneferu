{% if block.settings.url %}
  <p class="ca-contact-line">
    <hk-icon name="{{ block.settings.icon }}" />
    <a href="{{ url(block.settings.url) }}">{{ block.settings.text }}</a>
  </p>
{% elsif block.settings.icon == 'banknote' %}
  <p class="ca-contact-line">
    <hk-icon name="{{ block.settings.icon }}" />
    <span>{{ block.settings.text }}</span>
  </p>
{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Contact line",
      "ar": "بيانات تواصل"
    },
    "version": 1,
    "settings": {
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["mail", "phone", "map-pin", "clock", "message-circle"],
        "default": "mail"
      },
      "text": {
        "type": "text",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "default": "",
        "localized": true,
        "maxLength": 80
      },
      "url": {
        "type": "link",
        "label": {
          "en": "Link (optional, for example tel: or mailto:)",
          "ar": "رابط (اختياري، مثل tel: أو mailto:)"
        },
        "default": ""
      }
    }
  }
</hk-schema>
