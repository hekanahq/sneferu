<div class="hn-footer-col">
  {% if block.settings.title %}
    <h3 class="hn-footer-title">{{ block.settings.title }}</h3>
  {% endif %}
  <div class="hn-footer-links">
    {% for item in block.blocks %}<a href="{{ url(item.settings.url) }}">{{ item.settings.label }}</a>{% endfor %}
  </div>
</div>
<hk-schema>
  {
    "name": {
      "en": "Link column",
      "ar": "عمود روابط"
    },
    "version": 1,
    "blocks": {
      "allowed": ["footer-link"],
      "max": 10
    },
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Title",
          "ar": "العنوان"
        },
        "default": {
          "ar": "روابط",
          "en": "Links"
        },
        "localized": true,
        "maxLength": 40
      }
    }
  }
</hk-schema>
