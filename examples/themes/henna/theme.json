{
  "id": "henna",
  "name": "Henna",
  "version": "1.0.4",
  "author": "Hekana",
  "description": "A warm glow makeup and hair care store: terracotta, sand and bronze on cream, round shade swatches under every product, shop-by-concern tiles and a look-ideas strip, with its own product, collection, cart, search, 404 and page designs.",
  "category": "beauty",
  "engine": "hk2",
  "engineCompatibility": "^2.0.0",
  "defaultLocale": "ar",
  "locales": ["ar", "en"],
  "settings": {},
  "money": {
    "format": "whole"
  },
  "tokens": {
    "colors": {
      "primary": "#8F4A2B",
      "secondary": "#4A2C1D",
      "accent": "#A8532F",
      "background": "#FFFBF7",
      "text": "#3A241A",
      "muted": "#7A5C4C",
      "surface": "#FFFFFF",
      "line": "#E8D5C6",
      "soft": "#EDE9E5",
      "sand": "#F2D9C4",
      "clay": "#E3BFA0",
      "tan": "#C99A75",
      "bronze": "#8F4A2B",
      "gold": "#C8964A",
      "on-primary": "#FFF6EC",
      "on-accent": "#FFFFFF"
    },
    "layout": {
      "contentWidth": "1160px"
    },
    "radius": {
      "md": "18px"
    },
    "fonts": {
      "heading": "Readex Pro",
      "body": "Cairo"
    }
  }
}
