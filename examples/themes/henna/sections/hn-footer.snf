<footer class="hn-footer hn-scheme-{{ section.settings.scheme }}">
  <div class="hn-wrap">
    {% if section.settings.show_newsletter %}
      <div class="hn-news">
        <div>
          {% if section.settings.newsletter_title %}
            <h2 class="hn-h3">{{ section.settings.newsletter_title }}</h2>
          {% endif %}
          {% if section.settings.newsletter_text %}
            <p class="hn-news-text">{{ section.settings.newsletter_text }}</p>
          {% endif %}
        </div>
        {% if section.settings.newsletter_link %}<hk-button
            label="{{ section.settings.newsletter_label | default: t('newsletter_cta') }}"
            href="{{ section.settings.newsletter_link }}"
            class="hn-cta"
          />{% endif %}
      </div>
    {% endif %}
    <div class="hn-footer-grid">
      <div class="hn-footer-about">
        <p class="hn-footer-name">{{ store.name }}</p>
        {% if section.settings.about_text %}
          <p class="hn-footer-note">{{ section.settings.about_text }}</p>
        {% endif %}
        <div class="hn-social-list">
          {% for block in section.blocks %}{% if block.type == 'social-link' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}
        </div>
      </div>
      {% if menu(section.settings.menu).items %}
        <div class="hn-footer-col hn-footer-menu-col">
          {% if menu(section.settings.menu).title %}
            <h3 class="hn-footer-title">{{ menu(section.settings.menu).title }}</h3>
          {% endif %}
          <div class="hn-footer-links">
            {% for item in menu(section.settings.menu).items %}{% if not item.children %}<a
                  href="{{ item.url }}"
                  aria-current="{{ item.active }}"
                >{{ item.title }}</a>{% endif %}{% endfor %}
          </div>
        </div>
        {% for item in menu(section.settings.menu).items %}
          {% if item.children %}
            <div class="hn-footer-col">
              <h3 class="hn-footer-title">{{ item.title }}</h3>
              <div class="hn-footer-links">
                {% for sub in item.children %}
                  <a href="{{ sub.url }}" aria-current="{{ sub.active }}">{{ sub.title }}</a>
                  {% for leaf in sub.children %}<a
                      class="hn-footer-deep"
                      href="{{ leaf.url }}"
                      aria-current="{{ leaf.active }}"
                    >{{ leaf.title }}</a>{% endfor %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}{% for block in section.blocks %}{% if block.type == 'footer-column' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}{% endif %}
      <div class="hn-footer-col hn-footer-contact">
        {% for block in section.blocks %}{% if block.type == 'contact-line' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}
      </div>
    </div>
    <div class="hn-footer-bottom">
      <p class="hn-copyright">
        {% if store.name %}© {{ store.name }}{% if section.settings.copyright %}. {{ section.settings.copyright }}{% endif %}{% elsif section.settings.copyright %}©
          {{ section.settings.copyright }}{% endif %}
      </p>
      <div class="hn-payments" aria-label="{{ t('payment_methods') }}">
        {% for block in section.blocks %}{% if block.type == 'payment-method' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}
      </div>
      {% if section.settings.show_language %}<hk-locale-switch class="hn-footer-locale" />{% endif %}
    </div>
  </div>
</footer>
<hk-schema>
  {
    "name": {
      "en": "Footer",
      "ar": "الفوتر"
    },
    "version": 1,
    "templates": ["footer"],
    "blocks": {
      "allowed": ["footer-column", "social-link", "contact-line", "payment-method"],
      "max": 24
    },
    "settings": {
      "menu": {
        "type": "menu",
        "label": {
          "en": "Menu (the link columns show when none is picked or it has no links)",
          "ar": "القائمة (أعمدة الروابط بتظهر لو مفيش قائمة أو مفيهاش روابط)"
        },
        "default": "footer"
      },
      "about_text": {
        "type": "textarea",
        "label": {
          "en": "About text",
          "ar": "نبذة عن المتجر"
        },
        "default": {
          "ar": "مكياج وعناية بالشعر بدرجات دافية. الدفع عند الاستلام وتوصيل لكل المحافظات.",
          "en": "Warm-toned makeup and hair care. Cash on delivery and delivery across Egypt."
        },
        "localized": true,
        "maxLength": 300
      },
      "copyright": {
        "type": "text",
        "label": {
          "en": "Copyright line (after the store name)",
          "ar": "سطر الحقوق (بعد اسم المتجر)"
        },
        "default": {
          "ar": "جميع الحقوق محفوظة",
          "en": "All rights reserved"
        },
        "localized": true,
        "maxLength": 100
      },
      "scheme": {
        "type": "select",
        "label": {
          "en": "Colour scheme",
          "ar": "ألوان الفوتر"
        },
        "options": ["sand", "paper", "ink", "accent"],
        "default": "sand"
      },
      "show_language": {
        "type": "boolean",
        "label": {
          "en": "Show language switch",
          "ar": "إظهار تبديل اللغة"
        },
        "default": true
      },
      "show_newsletter": {
        "type": "boolean",
        "label": {
          "en": "Show newsletter box",
          "ar": "إظهار صندوق النشرة"
        },
        "default": false
      },
      "newsletter_title": {
        "type": "text",
        "label": {
          "en": "Newsletter title",
          "ar": "عنوان النشرة"
        },
        "default": {
          "ar": "خلّيك معانا",
          "en": "Stay with us"
        },
        "localized": true,
        "maxLength": 80,
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      },
      "newsletter_text": {
        "type": "textarea",
        "label": {
          "en": "Newsletter text",
          "ar": "نص النشرة"
        },
        "default": {
          "ar": "جديد المنتجات والدرجات على واتساب.",
          "en": "New products and shades on WhatsApp."
        },
        "localized": true,
        "maxLength": 160,
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      },
      "newsletter_label": {
        "type": "text",
        "label": {
          "en": "Newsletter button",
          "ar": "زر النشرة"
        },
        "default": "",
        "localized": true,
        "maxLength": 30,
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      },
      "newsletter_link": {
        "type": "link",
        "label": {
          "en": "Newsletter link",
          "ar": "رابط الاشتراك"
        },
        "default": "",
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      }
    }
  }
</hk-schema>
