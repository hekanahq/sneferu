{% if collection(section.settings.collection).products %}
  <section class="hn-sec hn-related hn-pad-{{ section.settings.padding_y }}">
    <div class="hn-wrap">
      {% if section.settings.title %}
        <h2 class="hn-h2">{{ section.settings.title }}</h2>
      {% endif %}
      <div class="hn-grid hn-cols-{{ section.settings.columns }}">
        {% for p in collection(section.settings.collection).products limit: section.settings.limit %}
          {% render 'card', p: p %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
<hk-schema>
  {
    "name": {
      "en": "More products",
      "ar": "منتجات تانية"
    },
    "version": 1,
    "templates": ["product", "404", "cart"],
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Heading",
          "ar": "العنوان"
        },
        "default": {
          "ar": "كمّلي مع منتجات تانية",
          "en": "More to try"
        },
        "localized": true,
        "maxLength": 80
      },
      "collection": {
        "type": "collection",
        "label": {
          "en": "Collection",
          "ar": "القسم"
        },
        "default": "featured"
      },
      "columns": {
        "type": "select",
        "label": {
          "en": "Columns",
          "ar": "الأعمدة"
        },
        "options": ["2", "3", "4"],
        "default": "4"
      },
      "limit": {
        "type": "range",
        "label": {
          "en": "Products",
          "ar": "عدد المنتجات"
        },
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4
      },
      "padding_y": {
        "type": "select",
        "label": {
          "en": "Vertical spacing",
          "ar": "المسافة الرأسية"
        },
        "options": ["compact", "normal", "roomy"],
        "default": "normal"
      }
    }
  }
</hk-schema>
