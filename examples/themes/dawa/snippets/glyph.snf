{% if name == 'mortar' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M4 11h16c0 4.4-3.6 8-8 8s-8-3.6-8-8z" /><path d="M8.5 21h7" /><path d="M10.5 8.5L16 2.5l2.2 1.8L13 10" /></svg>
{% elsif name == 'bottle' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M8 3h8v3H8z" /><path d="M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1z" /><path d="M12 11v5M9.5 13.5h5" /></svg>
{% elsif name == 'baby' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><circle cx="12" cy="12.5" r="8" /><path d="M12 4.5c0 1.6 1 2.4 2.2 2.4" /><path d="M9.5 12v.5M14.5 12v.5" /><path
      d="M9.5 15.5c1.5 1.4 3.5 1.4 5 0"
    /></svg>
{% elsif name == 'drop' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M12 3c3.5 4.5 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 2.5-6.5 6-11z" /><path d="M9 14.5a3 3 0 0 0 3 3" /></svg>
{% elsif name == 'thermometer' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0z" /><path d="M12 9v7" /></svg>
{% elsif name == 'pharmacist' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><circle cx="12" cy="7" r="3.5" /><path d="M5 21v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2" /><path
      d="M12 15.5v3M10.5 17h3"
    /></svg>
{% elsif name == 'cross' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z" /></svg>
{% elsif name == 'pill' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M10.5 20.5l-7-7a4.95 4.95 0 0 1 7-7l7 7a4.95 4.95 0 0 1-7 7z" /><path d="M8.5 8.5l7 7" /></svg>
{% elsif name == 'leaf' %}<svg
    class="ic ic-{{ name }}"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15" /><path d="M5 19l8-8" /></svg>
{% elsif name == 'heart-pulse' %}<svg
    class="ic ic-{{ name }}"
