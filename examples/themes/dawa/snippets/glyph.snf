    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  ><path d="M20.4 5.6a5 5 0 0 0-7.1 0L12 7l-1.3-1.4a5 5 0 0 0-7.1 7.1L12 21l8.4-8.3a5 5 0 0 0 0-7.1z" /><path
      d="M5 12h3l1.5-3 3 6 1.5-3h3"
    /></svg>
{% else %}<hk-icon name="{{ name }}" class="ic" />{% endif %}
