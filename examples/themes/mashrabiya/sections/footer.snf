<footer class="mb-footer mb-scheme-{{ section.settings.scheme }}">
  <hk-container>
    {% if section.settings.show_newsletter %}
      <div class="mb-newsletter">
        <div>
          {% if section.settings.newsletter_title %}
            <h2 class="mb-footer-title">{{ section.settings.newsletter_title }}</h2>
          {% endif %}
          {% if section.settings.newsletter_text %}
            <p>{{ section.settings.newsletter_text }}</p>
          {% endif %}
        </div>
        {% if section.settings.newsletter_link %}
          <hk-button
            label="{{ section.settings.newsletter_label | default: t('newsletter_cta') }}"
            href="{{ section.settings.newsletter_link }}"
            variant="outline"
          />
        {% endif %}
      </div>
    {% endif %}
    <div class="mb-footer-grid">
      <div class="mb-footer-about">
        <p class="mb-footer-brand">{{ store.name }}</p>
        {% if section.settings.about_text %}
          <p>{{ section.settings.about_text }}</p>
        {% endif %}
        <div class="mb-social-list">
          {% for block in section.blocks %}{% if block.type == 'social-link' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}
        </div>
      </div>
      {% if menu(section.settings.menu).items %}
        <div class="mb-footer-col mb-footer-menu-col">
          {% if menu(section.settings.menu).title %}
            <h3 class="mb-footer-title">{{ menu(section.settings.menu).title }}</h3>
          {% endif %}
          <div class="mb-footer-links">
            {% for item in menu(section.settings.menu).items %}
              {% if not item.children %}
                <a href="{{ item.url }}" aria-current="{{ item.active }}">{{ item.title }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% for item in menu(section.settings.menu).items %}
          {% if item.children %}
            <div class="mb-footer-col">
              <h3 class="mb-footer-title">{{ item.title }}</h3>
              <div class="mb-footer-links">
                {% for sub in item.children %}
                  <a href="{{ sub.url }}" aria-current="{{ sub.active }}">{{ sub.title }}</a>
                  {% for leaf in sub.children %}
                    <a
                      class="mb-footer-deep"
                      href="{{ leaf.url }}"
                      aria-current="{{ leaf.active }}"
                    >{{ leaf.title }}</a>
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}{% for block in section.blocks %}{% if block.type == 'footer-column' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}{% endif %}
      <div class="mb-footer-contact">
        {% for block in section.blocks %}{% if block.type == 'contact-line' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}
      </div>
    </div>
    <div class="mb-footer-bottom">
      <p class="mb-copyright">
        {% if store.name %}© {{ store.name }}{% if section.settings.copyright %}. {{ section.settings.copyright }}{% endif %}{% elsif section.settings.copyright %}©
          {{ section.settings.copyright }}{% endif %}
      </p>
      <div class="mb-payments" aria-label="{{ t('payment_methods') }}">
        {% for block in section.blocks %}{% if block.type == 'payment-method' %}<hk-block of="{{ block }}" />{% endif %}{% endfor %}
      </div>
      {% if section.settings.show_language %}<hk-locale-switch />{% endif %}
    </div>
  </hk-container>
</footer>
<hk-schema>
  {
    "name": {
      "en": "Footer",
      "ar": "الفوتر"
    },
    "version": 1,
    "templates": ["footer"],
    "blocks": {
      "allowed": ["footer-column", "social-link", "contact-line", "payment-method"],
      "max": 24
    },
    "settings": {
      "menu": {
        "type": "menu",
        "label": {
          "en": "Menu (the link columns show when none is picked or it has no links)",
          "ar": "القائمة (أعمدة الروابط بتظهر لو مفيش قائمة أو مفيهاش روابط)"
        },
        "default": ""
      },
      "about_text": {
        "type": "textarea",
        "label": {
          "en": "About text",
          "ar": "نبذة عن المتجر"
        },
        "default": "",
        "localized": true,
        "maxLength": 300
      },
      "copyright": {
        "type": "text",
        "label": {
          "en": "Copyright line (after the store name)",
          "ar": "سطر الحقوق (بعد اسم المتجر)"
        },
        "default": {
          "ar": "جميع الحقوق محفوظة",
          "en": "All rights reserved"
        },
        "localized": true,
        "maxLength": 100
      },
      "scheme": {
        "type": "select",
        "label": {
          "en": "Colour scheme",
          "ar": "ألوان الفوتر"
        },
        "options": ["light", "primary", "accent"],
        "default": "light"
      },
      "show_language": {
        "type": "boolean",
        "label": {
          "en": "Show language switch",
          "ar": "إظهار تبديل اللغة"
        },
        "default": false
      },
      "show_newsletter": {
        "type": "boolean",
        "label": {
          "en": "Show contact box",
          "ar": "إظهار صندوق التواصل"
        },
        "default": false
      },
      "newsletter_title": {
        "type": "text",
        "label": {
          "en": "Contact box title",
          "ar": "عنوان التواصل"
        },
        "default": {
          "ar": "كلمنا على واتساب",
          "en": "Talk to us on WhatsApp"
        },
        "localized": true,
        "maxLength": 80,
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      },
      "newsletter_text": {
        "type": "textarea",
        "label": {
          "en": "Contact box text",
          "ar": "نص التواصل"
        },
        "default": {
          "ar": "اسأل عن قطعة أو مقاس أو لون قبل ما تطلب.",
          "en": "Ask about a piece, a size or a colour before you order."
        },
        "localized": true,
        "maxLength": 160,
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      },
      "newsletter_label": {
        "type": "text",
        "label": {
          "en": "Contact box button",
          "ar": "زر التواصل"
        },
        "default": "",
        "localized": true,
        "maxLength": 30,
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      },
      "newsletter_link": {
        "type": "link",
        "label": {
          "en": "Contact box link",
          "ar": "رابط التواصل"
        },
        "default": "",
        "visible_if": {
          "setting": "show_newsletter",
          "equals": true
        }
      }
    }
  }
</hk-schema>
