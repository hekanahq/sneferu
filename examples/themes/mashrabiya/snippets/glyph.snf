<svg
  class="ic ic-{{ name }}"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {% if name == 'lantern' %}<path
      d="M12 2v3M9.5 5h5l1 2.5h-7zM8.5 7.5c-1.2 3-1.2 7 0 10h7c1.2-3 1.2-7 0-10M12 7.5v10M9 17.5l3 3.5 3-3.5"
    />
  {% elsif name == 'kilim' %}<path d="M12 3l8 9-8 9-8-9zM12 8l4 4-4 4-4-4zM12 11l1 1-1 1-1-1z" />
  {% elsif name == 'vessel' %}<path
      d="M9.5 3h5M10 3v3c-3 1.4-5 4-5 8 0 3.2 2.4 5.6 7 7 4.6-1.4 7-3.8 7-7 0-4-2-6.6-5-8V3M8 21h8"
    />
  {% elsif name == 'lattice' %}<path d="M4 4h16v16H4zM12 4l8 8-8 8-8-8zM4 12h16M12 4v16" />
  {% endif %}
</svg>
