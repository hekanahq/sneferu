<p class="ls-feature">
  {% render 'glyph', name: 'check' %}<span>{{ block.settings.text }}</span>
</p>
<hk-schema>
  {
    "name": {
      "en": "Feature",
      "ar": "ميزة"
    },
    "version": 1,
    "settings": {
      "text": {
        "type": "text",
        "label": {
          "en": "Feature",
          "ar": "الميزة"
        },
        "default": {
          "ar": "مفتاح الترخيص على الإيميل بعد الدفع",
          "en": "Licence key by email after payment"
        },
        "localized": true,
        "maxLength": 80
      }
    }
  }
</hk-schema>
