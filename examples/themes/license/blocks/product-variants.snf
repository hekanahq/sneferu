<hk-variant-picker product="{{ product }}" display="{{ block.settings.style }}" />
<hk-schema>
  {
    "name": {
      "en": "Variant picker",
      "ar": "اختيار النسخة"
    },
    "version": 1,
    "settings": {
      "style": {
        "type": "select",
        "label": {
          "en": "Style",
          "ar": "الشكل"
        },
        "options": ["auto", "swatches", "buttons", "select"],
        "default": "auto"
      }
    }
  }
</hk-schema>
