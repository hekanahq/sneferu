      x="2"
      y="2"
      width="20"
      height="20"
      rx="5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    /><path
      d="M7 12.5l3.2 3.2L17 9"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    /></svg>
{% endif %}
