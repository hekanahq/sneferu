<section class="ls-features" id="features">
  <div class="ls-wrap">
    <div class="ls-head">
      <h2 class="ls-h2">{{ section.settings.heading }}</h2>
      <p class="ls-side">{{ section.settings.side }}</p>
    </div>
    <div class="ls-feature-grid">
      {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
    </div>
  </div>
</section>
<hk-schema>
  {
    "name": {
      "en": "Features",
      "ar": "المميزات"
    },
    "version": 1,
    "blocks": {
      "allowed": ["feature"],
      "max": 12
    },
    "settings": {
      "heading": {
        "type": "text",
        "label": {
          "en": "Heading",
          "ar": "العنوان"
        },
        "default": {
          "ar": "في كل ترخيص",
          "en": "In every licence"
        },
        "localized": true,
        "maxLength": 60
      },
      "side": {
        "type": "text",
        "label": {
          "en": "Side note",
          "ar": "ملاحظة جانبية"
        },
        "default": {
          "ar": "من غير شحن ومن غير انتظار",
          "en": "Nothing to ship, nothing to wait for"
        },
        "localized": true,
        "maxLength": 80
      }
    }
  }
</hk-schema>
