{% if section.settings.text %}
  <div class="ls-announce ls-scheme-{{ section.settings.scheme }}">
    <div class="ls-wrap">
      <p class="ls-announce-text">
        {% if section.settings.link %}
          <a href="{{ url(section.settings.link) }}">{{ section.settings.text }}</a>
        {% else %}
          {{ section.settings.text }}
        {% endif %}
      </p>
    </div>
  </div>
{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Announcement bar",
      "ar": "شريط الإعلان"
    },
    "version": 1,
    "templates": ["announcement"],
    "settings": {
      "text": {
        "type": "text",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "default": "",
        "localized": true,
        "maxLength": 140
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": ""
      },
      "scheme": {
        "type": "select",
        "label": {
          "en": "Colour scheme",
          "ar": "ألوان الشريط"
        },
        "options": ["lime", "blue", "navy"],
        "default": "lime"
      }
    }
  }
</hk-schema>
