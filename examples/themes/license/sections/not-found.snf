<hk-section class="ls-sec" padding-y="{{ section.settings.padding_y }}" mobile-padding-y="32">
  <div class="ls-empty ls-nf">
    {% if section.settings.code %}
      <p class="ls-nf-code" aria-hidden="true">{{ section.settings.code }}</p>
    {% endif %}
    {% if section.settings.image %}
      <hk-image src="{{ section.settings.image }}" alt="" width="280" />
    {% endif %}
    {% if section.settings.title %}
      <h1 class="ls-title ls-nf-title">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.text %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.show_search %}
      <div class="ls-search-page">
        <hk-search-form placeholder="{{ t('search_placeholder') }}" class="ls-search ls-search-big" />
      </div>
    {% endif %}
    {% if section.settings.button_label %}<a
        class="ls-btn"
        href="{{ url(section.settings.button_link) }}"
      >{{ section.settings.button_label }}</a>{% endif %}
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Page not found",
      "ar": "صفحة مش موجودة"
    },
    "version": 1,
    "templates": ["404"],
    "settings": {
      "code": {
        "type": "text",
        "label": {
          "en": "Big number",
          "ar": "الرقم الكبير"
        },
        "default": "404",
        "localized": false,
        "maxLength": 8
      },
      "image": {
        "type": "image",
        "label": {
          "en": "Image",
          "ar": "صورة"
        },
        "default": ""
      },
      "title": {
        "type": "text",
        "label": {
          "en": "Title",
          "ar": "العنوان"
        },
        "default": {
          "ar": "الصفحة دي مش موجودة",
          "en": "This page does not exist"
        },
        "localized": true,
        "maxLength": 80
      },
      "text": {
        "type": "textarea",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "default": {
          "ar": "ممكن الرابط اتغير أو اتمسح. ابدأ من الرئيسية.",
          "en": "The link may have changed or been removed. Start from the home page."
        },
        "localized": true,
        "maxLength": 200
      },
      "show_search": {
        "type": "boolean",
        "label": {
          "en": "Show search field",
          "ar": "إظهار حقل البحث"
        },
        "default": true
      },
      "button_label": {
        "type": "text",
        "label": {
          "en": "Button",
          "ar": "الزر"
        },
        "default": {
          "ar": "ارجع للرئيسية",
          "en": "Back to the home page"
        },
        "localized": true,
        "maxLength": 30
      },
      "button_link": {
        "type": "link",
        "label": {
          "en": "Button link",
          "ar": "رابط الزر"
        },
        "default": "/"
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding (px)",
          "ar": "المسافة الرأسية (بكسل)"
        },
        "default": 56,
        "min": 0,
        "max": 120,
        "step": 4
      }
    }
  }
</hk-schema>
