<section class="ls-features" id="features">
  <div class="ls-wrap">
    <div class="ls-head">
      <h2 class="ls-h2">{{ section.settings.heading }}</h2>
      <p class="ls-side">{{ section.settings.side }}</p>
    </div>
    <div class="ls-feature-grid">
      {% for block in section.blocks %}
        <hk-block of="{{ block }}" />
      {% endfor %}
    </div>
  </div>
</section>
<hk-schema>
  {
    "name": "Features",
    "version": 1,
    "settings": {
      "heading": {
        "type": "text",
        "label": "Heading",
        "localized": true,
        "default": {
          "ar": "في كل ترخيص",
          "en": "In every licence"
        },
        "maxLength": 60
      },
      "side": {
        "type": "text",
        "label": "Side note",
        "localized": true,
        "default": {
          "ar": "من غير شحن ومن غير انتظار",
          "en": "Nothing to ship, nothing to wait for"
        },
        "maxLength": 80
      }
    },
    "blocks": {
      "allowed": ["feature"],
      "max": 12
    }
  }
</hk-schema>
