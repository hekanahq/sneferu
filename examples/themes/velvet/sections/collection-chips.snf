<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="20">
  <div class="vl-chips">
    {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Category links",
      "ar": "روابط الأقسام"
    },
    "version": 1,
    "templates": ["index"],
    "blocks": {
      "allowed": ["chip-link"],
      "max": 4
    },
    "settings": {
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 160,
        "step": 8,
        "default": 24
      }
    }
  }
</hk-schema>
