<article class="vl-card vl-card-{{ card_style }}">
  <a class="vl-card-link" href="{{ product.url }}">
    <div class="vl-card-media">
      <hk-image
        src="{{ product.image }}"
        alt="{{ product.title }}"
        aspect-ratio="{{ image_ratio }}"
        sizes="(min-width: 1024px) 30vw, 50vw"
      />
      {% if show_badge %}
        {% if product.available %}
          {% if product.compare_at > product.price %}
            <span class="vl-badge">{{ t('sale') }}</span>
          {% endif %}
        {% else %}
          <span class="vl-badge vl-badge-muted">{{ t('sold_out_badge') }}</span>
        {% endif %}
      {% endif %}
    </div>
    <div class="vl-card-body">
      <h3 class="vl-card-title">{{ product.title }}</h3>
      {% if show_price %}{% render 'price', product: product, bind: false %}{% endif %}
      {% if product.tags %}{% for tag in product.tags limit: 1 %}<span class="vl-karat">{{ tag }}</span>{% endfor %}{% endif %}
    </div>
  </a>
</article>
