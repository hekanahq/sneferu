<a class="vl-chip-link" href="{{ url(block.settings.link) }}">
  <span class="vl-chip-title">{{ block.settings.title }}</span>
  {% if block.settings.note %}<span class="vl-chip-note">{{ block.settings.note }}</span>{% endif %}
</a>
<hk-schema>
  {
    "name": {
      "en": "Category link",
      "ar": "رابط قسم"
    },
    "version": 1,
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Title",
          "ar": "العنوان"
        },
        "localized": true,
        "default": {
          "en": "Necklaces",
          "ar": "السلاسل"
        },
        "maxLength": 30
      },
      "note": {
        "type": "text",
        "label": {
          "en": "Small line under the title (empty hides it)",
          "ar": "سطر صغير تحت العنوان (فاضي يخفيه)"
        },
        "localized": true,
        "default": {
          "en": "",
          "ar": ""
        },
        "maxLength": 40
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/products"
      }
    }
  }
</hk-schema>
