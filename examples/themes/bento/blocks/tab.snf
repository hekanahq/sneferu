<a href="{{ url(block.settings.link) }}" aria-current="{{ block.settings.current }}">{{ block.settings.label }}</a>
<hk-schema>
  {
    "name": {
      "en": "Tab",
      "ar": "تاب"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Label",
          "ar": "النص"
        },
        "localized": true,
        "default": {
          "ar": "الكل",
          "en": "All"
        },
        "maxLength": 30
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link (a page, or #<collection handle> for a shelf on this page)",
          "ar": "الرابط (صفحة، أو #اسم-القسم لرف في الصفحة دي)"
        },
        "default": "#shop"
      },
      "current": {
        "type": "boolean",
        "label": {
          "en": "Underlined as the current tab",
          "ar": "مسطّر كأنه التاب الحالي"
        },
        "default": false
      }
    }
  }
</hk-schema>
