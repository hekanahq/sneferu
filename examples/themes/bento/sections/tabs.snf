<nav class="bt-tabs" aria-label="{{ t('tabs_label') }}">
  <div class="bt-wrap bt-tabs-row">
    {% for block in section.blocks %}
      <hk-block of="{{ block }}" />
    {% endfor %}
  </div>
</nav>
<hk-schema>
  {
    "name": {
      "en": "Category tabs",
      "ar": "تابات الأقسام"
    },
    "version": 1,
    "settings": {},
    "blocks": {
      "allowed": ["tab"],
      "max": 8
    }
  }
</hk-schema>
