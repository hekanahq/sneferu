<section class="bt-bento" id="shop">
  <div class="bt-wrap bt-bento-grid">
    {% for block in section.blocks %}
      <hk-block of="{{ block }}" />
    {% endfor %}
  </div>
</section>
<hk-schema>
  {
    "name": {
      "en": "Bento shelves",
      "ar": "رفوف بينتو"
    },
    "version": 1,
    "settings": {},
    "blocks": {
      "allowed": ["shelf"],
      "max": 4
    }
  }
</hk-schema>
