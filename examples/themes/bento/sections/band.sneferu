<section class="bt-band-wrap">
  <div class="bt-wrap">
    <div class="bt-band">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      <hk-button label="{{ section.settings.button }}" href="{{ section.settings.link }}" class="bt-band-button" />
    </div>
  </div>
</section>
<hk-schema>
  {
    "name": "Call to action band",
    "version": 1,
    "settings": {
      "heading": {
        "type": "text",
        "label": "Heading",
        "localized": true,
        "default": {
          "ar": "اطبع النهارده",
          "en": "Print it today"
        },
        "maxLength": 80
      },
      "text": {
        "type": "textarea",
        "label": "Text",
        "localized": true,
        "default": {
          "ar": "ادفع أونلاين ورابط التحميل يوصلك على الإيميل على طول.",
          "en": "Pay online and the download link is emailed to you right away."
        },
        "maxLength": 200
      },
      "button": {
        "type": "text",
        "label": "Button",
        "localized": true,
        "default": {
          "ar": "تصفّح كل المنتجات",
          "en": "Browse all products"
        },
        "maxLength": 30
      },
      "link": {
        "type": "link",
        "label": "Button link",
        "default": "/products"
      }
    }
  }
</hk-schema>
