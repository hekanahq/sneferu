{% if name == 'user' %}
  <svg class="bt-glyph" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><circle
      cx="13"
      cy="13"
      r="13"
      fill="currentColor"
    /><circle class="bt-glyph-cut" cx="13" cy="10.5" r="4" /><path
      class="bt-glyph-cut"
      d="M5.5 21.5c1.4-3.3 4.3-5 7.5-5s6.1 1.7 7.5 5"
    /></svg>
{% endif %}
{% if name == 'smile' %}
  <svg class="bt-glyph-big" width="120" height="120" viewBox="0 0 120 120" aria-hidden="true">
    <g class="bt-glyph-rays" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none">
      <path d="M60 6v14M60 100v14M6 60h14M100 60h14M22 22l10 10M88 88l10 10M98 22L88 32M32 88L22 98" />
    </g>
    <circle class="bt-glyph-face" cx="60" cy="60" r="30" />
    <circle cx="50" cy="55" r="3.5" fill="currentColor" />
    <circle cx="70" cy="55" r="3.5" fill="currentColor" />
    <path d="M47 68c4 8 22 8 26 0" stroke="currentColor" stroke-width="4" stroke-linecap="round" fill="none" />
  </svg>
{% endif %}
