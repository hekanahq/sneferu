{% if name == 'search' %}
  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle
      cx="11"
      cy="11"
      r="7"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
{% elsif name == 'bag' %}
  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path
      d="M5 8h14l-1 13H6z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    /><path d="M9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="2" /></svg>
{% elsif name == 'heart' %}
  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path
      d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    /></svg>
{% elsif name == 'user' %}
  <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><circle
      cx="13"
      cy="13"
      r="13"
      fill="currentColor"
    /><circle cx="13" cy="10.5" r="4" fill="#FFFFFF" /><path
      d="M5.5 21.5c1.4-3.3 4.3-5 7.5-5s6.1 1.7 7.5 5"
      fill="#FFFFFF"
    /></svg>
{% elsif name == 'menu' %}
  <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path
      d="M4 7h16M4 12h16M4 17h16"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    /></svg>
{% elsif name == 'plus' %}
  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path
      d="M12 5v14M5 12h14"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    /></svg>
{% endif %}
