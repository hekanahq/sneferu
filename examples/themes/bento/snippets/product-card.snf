<article class="bt-pc bt-pc-{{ card_style }}">
  <a class="bt-pc-link" href="{{ product.url }}">
    <div class="bt-pc-media">
      <hk-image
        src="{{ product.image }}"
        alt="{{ product.title }}"
        aspect-ratio="{{ image_ratio }}"
        sizes="(min-width: 1024px) 25vw, 50vw"
      />
      {% if show_badge %}
        {% if product.available %}
          {% if product.compare_at > product.price %}
            <span class="bt-badge">{{ t('sale') }}</span>
          {% endif %}
        {% else %}
          <span class="bt-badge bt-badge-muted">{{ t('sold_out_badge') }}</span>
        {% endif %}
      {% endif %}
    </div>
    <h3 class="bt-pc-title">{{ product.title }}</h3>
    {% if show_price %}{% render 'price', product: product, bind: false %}{% endif %}
  </a>
</article>
