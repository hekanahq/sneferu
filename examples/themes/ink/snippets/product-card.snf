<article class="ik-card ik-card-{{ card_style }}">
  <a class="ik-card-link" href="{{ product.url }}">
    <div class="ik-card-media">
      <hk-image
        src="{{ product.image }}"
        alt="{{ product.title }}"
        aspect-ratio="{{ image_ratio }}"
        sizes="(min-width: 1024px) 25vw, 50vw"
      />
      {% if show_badge %}
        {% if product.available %}
          {% if product.compare_at > product.price %}
            <span class="ik-badge">{{ t('sale') }}</span>
          {% endif %}
        {% else %}
          <span class="ik-badge ik-badge-muted">{{ t('sold_out_badge') }}</span>
        {% endif %}
      {% endif %}
    </div>
    <h3 class="ik-card-title">{{ product.title }}</h3>
    <div class="ik-card-foot">
      {% if show_price %}{% render 'price', product: product, bind: false %}{% endif %}
      <span class="ik-plus" aria-hidden="true"><hk-icon name="plus" /></span>
    </div>
  </a>
</article>
