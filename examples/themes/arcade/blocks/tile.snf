<a class="arc-tile" href="{{ url(block.settings.link) }}">
  <span class="arc-tile-icon">
    {% if block.settings.icon == 'gem' %}
      {% render 'glyph', name: 'gem' %}
    {% else %}
      <hk-icon name="{{ block.settings.icon }}" class="ic" />
    {% endif %}
  </span>
  <span class="arc-tile-title">{{ block.settings.title }}</span>
</a>
<hk-schema>
  {
    "name": {
      "en": "Category tile",
      "ar": "مربع قسم"
    },
    "version": 1,
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Title",
          "ar": "العنوان"
        },
        "localized": true,
        "default": {
          "ar": "كروت الهدايا",
          "en": "Gift cards"
        },
        "maxLength": 32
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/category/gift-cards"
      },
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": [
          "credit-card",
          "gem",
          "zap",
          "calendar",
          "gamepad-2",
          "smartphone",
          "trophy",
          "gift",
          "monitor",
          "headphones",
          "key",
          "sparkles"
        ],
        "default": "credit-card"
      }
    }
  }
</hk-schema>
