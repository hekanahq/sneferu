<hk-section padding-y="32" mobile-padding-y="16" class="arc-hero">
  <nav class="arc-tabs" aria-label="{{ t('platforms') }}">
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}<hk-block of="{{ block }}" />{% endif %}
    {% endfor %}
  </nav>
  <hk-stack gap="28" mobile-gap="20" align="center">
    <hk-heading
      text="{{ section.settings.title }}"
      level="h1"
      size="44"
      tablet-size="36"
      mobile-size="24"
      align="center"
      class="arc-title"
    />
    <div class="arc-chips">
      {% for block in section.blocks %}
        {% if block.type == 'chip' %}<hk-block of="{{ block }}" />{% endif %}
      {% endfor %}
    </div>
    <div class="arc-actions">
      <hk-button
        label="{{ section.settings.button }}"
        href="{{ section.settings.button_link }}"
        variant="outline"
        size="sm"
        class="arc-browse"
      />
      <span class="arc-instant">
        <span class="arc-instant-icon"><hk-icon name="zap" class="ic" /></span>
        {{ section.settings.note }}
      </span>
    </div>
  </hk-stack>
</hk-section>
<hk-schema>
  {
    "name": "Arcade hero",
    "version": 1,
    "settings": {
      "title": {
        "type": "text",
        "label": "Title",
        "localized": true,
        "default": {
          "ar": "كروت الألعاب والشحن",
          "en": "Game cards and top-ups"
        },
        "maxLength": 80
      },
      "button": {
        "type": "text",
        "label": "Button",
        "localized": true,
        "default": {
          "ar": "تصفح الكروت",
          "en": "Browse cards"
        },
        "maxLength": 30
      },
      "button_link": {
        "type": "link",
        "label": "Button link",
        "default": "/category/gift-cards"
      },
      "note": {
        "type": "text",
        "label": "Note next to the button",
        "localized": true,
        "default": {
          "ar": "تسليم فوري",
          "en": "Instant delivery"
        },
        "maxLength": 40
      }
    },
    "blocks": {
      "allowed": ["tab", "chip"],
      "max": 16
    }
  }
</hk-schema>
