{
  "id": "arcade",
  "name": "Arcade",
  "version": "2.0.2",
  "author": "Hekana",
  "description": "A complete dark gaming store for gift cards and top-ups: neon cyan and lime, amount chips, category tiles, redeem steps, and its own product, collection, cart, search, 404 and page designs.",
  "category": "gaming",
  "engine": "hk2",
  "engineCompatibility": "^2.0.0",
  "defaultLocale": "ar",
  "locales": ["ar", "en"],
  "settings": {},
  "tokens": {
    "colors": {
      "primary": "#22D3EE",
      "secondary": "#0D141C",
      "accent": "#A3E635",
      "background": "#070A0F",
      "text": "#E6EDF3",
      "muted": "#8B98A9",
      "surface": "#0C1219",
      "surface-2": "#111B25",
      "line": "#1C2A36",
      "on-primary": "#04131A",
      "on-accent": "#04131A",
      "on-sale": "#FB923C"
    },
    "layout": { "contentWidth": "1200px" },
    "radius": { "md": "12px" },
    "fonts": {
      "heading": "Rubik",
      "body": "Rubik",
      "mono": "JetBrains Mono"
    }
  }
}
