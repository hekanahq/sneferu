<hk-section padding-y="48" mobile-padding-y="32" class="cc-faq">
  <div id="faq" class="cc-faq-wrap">
    <hk-heading text="{{ section.settings.heading }}" level="h2" size="24" mobile-size="20" class="cc-h2" />
    {% for block in section.blocks %}
      <hk-block of="{{ block }}" />
    {% endfor %}
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "FAQ",
      "ar": "أسئلة شائعة"
    },
    "version": 1,
    "settings": {
      "heading": {
        "type": "text",
        "label": {
          "en": "Heading",
          "ar": "العنوان"
        },
        "localized": true,
        "default": {
          "ar": "أسئلة شائعة",
          "en": "Questions"
        },
        "maxLength": 60
      }
    },
    "blocks": {
      "allowed": ["faq-item"],
      "max": 12
    }
  }
</hk-schema>
