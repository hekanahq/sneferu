<hk-section padding-y="24" mobile-padding-y="16" class="cc-amounts">
  <nav class="cc-seg" aria-label="{{ t('amounts_label') }}">
    {% for block in section.blocks %}
      <hk-block of="{{ block }}" />
    {% endfor %}
  </nav>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Amount selector",
      "ar": "اختيار القيمة"
    },
    "version": 1,
    "settings": {},
    "blocks": {
      "allowed": ["amount"],
      "max": 3
    }
  }
</hk-schema>
