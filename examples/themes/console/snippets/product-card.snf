<article class="cc-card cc-card-{{ card_style }}">
  <a class="cc-card-link" href="{{ product.url }}">
    <div class="cc-card-media">
      <hk-image
        src="{{ product.image }}"
        alt="{{ product.title }}"
        aspect-ratio="{{ image_ratio }}"
        sizes="(min-width: 1024px) 25vw, 50vw"
      />
      {% if show_badge %}
        {% if product.available %}
          {% if product.compare_at > product.price %}
            <span class="cc-badge">{{ t('sale') }}</span>
          {% endif %}
        {% else %}
          <span class="cc-badge cc-badge-muted">{{ t('sold_out_badge') }}</span>
        {% endif %}
      {% endif %}
    </div>
    <h3 class="cc-card-title">{{ product.title }}</h3>
    {% if product.digital_kind == 'code' %}
      <span class="cc-card-note"><hk-icon name="zap" /><span>{{ t('card_code_note') }}</span></span>
    {% endif %}
    {% if show_price %}{% render 'price', product: product, bind: false %}{% endif %}
  </a>
</article>
