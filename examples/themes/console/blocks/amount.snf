<a
  class="cc-seg-item"
  data-active="{{ block.settings.highlight }}"
  href="{{ url('/search') }}"
>{{ block.settings.amount | money: 'whole', 'major' }}</a>
<hk-schema>
  {
    "name": {
      "en": "Amount",
      "ar": "قيمة"
    },
    "version": 1,
    "settings": {
      "amount": {
        "type": "number",
        "label": {
          "en": "Amount (EGP)",
          "ar": "القيمة (جنيه)"
        },
        "default": 500,
        "min": 1,
        "max": 100000
      },
      "highlight": {
        "type": "boolean",
        "label": {
          "en": "Highlight",
          "ar": "تمييز"
        },
        "default": false
      }
    }
  }
</hk-schema>
