<hk-section padding-y="32" mobile-padding-y="24" class="tk-trust-band">
  <ul class="tk-trust-list">
    {% for block in section.blocks %}
      <hk-block of="{{ block }}" />
    {% endfor %}
  </ul>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Trust strip",
      "ar": "شريط الثقة"
    },
    "version": 1,
    "settings": {},
    "blocks": {
      "allowed": ["trust"],
      "max": 4
    }
  }
</hk-schema>
