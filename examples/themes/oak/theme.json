    "format": "whole"
  },
  "tokens": {
    "colors": {
      "primary": "#7A5A36",
      "secondary": "#2F2D2A",
      "accent": "#E9DFCB",
      "background": "#FBF9F5",
      "text": "#2B2A28",
      "muted": "#675F55",
      "line": "#E4DBCB",
      "soft": "#F2ECE0",
      "surface": "#FFFFFF",
      "oak": "#7A5A36",
      "oakLight": "#C9A878",
      "oat": "#EFE7D8",
      "charcoal": "#2F2D2A"
