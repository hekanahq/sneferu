<hk-sections />
<hk-schema>
  {
    "sections": [
      {
        "type": "product-main",
        "blocks": [
          {
            "type": "product-category"
          },
          {
            "type": "product-title"
          },
          {
            "type": "product-price"
          },
          {
            "type": "product-excerpt"
          },
          {
            "type": "product-variants"
          },
          {
            "type": "product-buy"
          },
          {
            "type": "note",
            "settings": {
              "text": {
                "ar": "الدفع عند الاستلام وتوصيل لكل المحافظات.",
                "en": "Cash on delivery and delivery across Egypt."
              },
              "icon": "truck"
            }
          },
          {
            "type": "product-description"
          },
          {
            "type": "product-tags"
          }
        ]
      },
      {
        "type": "related-products"
      }
    ]
  }
</hk-schema>
