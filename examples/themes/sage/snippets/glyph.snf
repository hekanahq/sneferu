<svg
  class="sg-glyph"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {% if name == 'leaf' %}<path d="M5 19C5 10 10 5 19 5c0 9-5 14-14 14z" /><path d="M5 19l8-8" />
  {% elsif name == 'drop' %}<path d="M12 3.5c3.5 4 6 7 6 10.2a6 6 0 0 1-12 0c0-3.2 2.5-6.2 6-10.2z" />
  {% elsif name == 'drops' %}<path d="M9 4c2.4 2.8 4 4.8 4 7a4 4 0 0 1-8 0c0-2.2 1.6-4.2 4-7z" /><path
      d="M16.5 12.5c1.6 1.8 2.7 3.2 2.7 4.7a2.7 2.7 0 0 1-5.4 0c0-1.5 1.1-2.9 2.7-4.7z"
    />
  {% elsif name == 'shield' %}<path d="M12 3l7 3v5.5c0 4.2-2.8 7.6-7 9.5-4.2-1.9-7-5.3-7-9.5V6l7-3z" /><path
      d="M9 12l2.2 2.2L15.5 10"
    />
  {% elsif name == 'sun' %}<circle cx="12" cy="12" r="3.8" /><path
      d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"
    />
  {% elsif name == 'flask' %}<path
      d="M9.5 3.5h5M10.5 3.5v5.2L5.6 17a2 2 0 0 0 1.7 3h9.4a2 2 0 0 0 1.7-3l-4.9-8.3V3.5"
    /><path d="M8 14h8" />
  {% elsif name == 'moon' %}<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
  {% endif %}
</svg>
