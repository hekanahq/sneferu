<svg
  class="ic ic-{{ name }}"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {% if name == 'drill' %}<path d="M2 7.5h12a2 2 0 0 1 2 2V12H10l-1 7H6l1-7H4a2 2 0 0 1-2-2z" /><path
      d="M16 8.5h3v2.5h-3M19 9.75h3"
    />
  {% elsif name == 'hammer' %}<path d="M10.5 11.5L4 18l2 2 6.5-6.5" /><path d="M9 6.5l4-3 6 6-3 4-7-7z" />
  {% elsif name == 'wrench' %}<path
      d="M14.5 6a4.2 4.2 0 0 0 5.2 5.2l-9.2 9.2a2.2 2.2 0 0 1-3.1-3.1l9.2-9.2A4.2 4.2 0 0 0 14.5 6z"
    />
  {% elsif name == 'saw' %}<path d="M3 19L21 5v5L8 19z" /><path d="M8 19l1.2-1.6 1.2 1.6 1.2-1.6 1.2 1.6" />
  {% elsif name == 'ruler' %}<rect x="2.5" y="8" width="19" height="8" rx="1" /><path
      d="M6.5 8v3M10.5 8v4.5M14.5 8v3M18.5 8v4.5"
    />
  {% elsif name == 'bolt' %}<path d="M12 2.5l8 4.5v10l-8 4.5-8-4.5V7z" /><circle cx="12" cy="12" r="3" />
  {% elsif name == 'plug' %}<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4" />
  {% elsif name == 'helmet' %}<path d="M4.5 15.5a7.5 7.5 0 0 1 15 0z" /><path d="M2.5 15.5h19v3h-19zM12 8V5" />
  {% elsif name == 'box' %}<path d="M3.5 8L12 3.5 20.5 8v8L12 20.5 3.5 16z" /><path
      d="M3.5 8L12 12.5 20.5 8M12 12.5v8"
    />
  {% endif %}
</svg>
