<a class="es-tab" href="{{ url(block.settings.link) }}">{{ block.settings.label }}</a>
<hk-schema>
  {
    "name": {
      "en": "Tab",
      "ar": "تبويب"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Label",
          "ar": "النص"
        },
        "localized": true,
        "default": {
          "ar": "الكل",
          "en": "All"
        },
        "maxLength": 20
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/products"
      }
    }
  }
</hk-schema>
