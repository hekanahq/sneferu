<svg class="es-art" viewBox="0 0 520 340" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
  <defs>
    <linearGradient id="es-rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="es-stop-accent" />
      <stop offset="1" class="es-stop-glow" />
    </linearGradient>
    <radialGradient id="es-glow" cx="0.5" cy="0.55" r="0.5">
      <stop offset="0" class="es-stop-forest" stop-opacity="0.55" />
      <stop offset="1" class="es-stop-forest" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="es-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="es-stop-surface" />
      <stop offset="1" class="es-stop-deep" />
