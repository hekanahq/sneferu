  </defs>
  <ellipse cx="260" cy="200" rx="250" ry="160" fill="url(#es-glow)" />
  <polygon points="40,340 92,250 104,340" class="es-fill-accent" opacity="0.9" />
  <polygon points="446,340 498,214 512,214 462,340" class="es-fill-accent" opacity="0.85" />
