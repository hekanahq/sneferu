<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="24">
  <div class="es-page es-width-{{ section.settings.width }} es-align-{{ section.settings.align }}">
    {% if section.settings.show_title %}{% render 'page-head', title: page.title %}{% endif %}
    <div class="es-prose"><hk-rich-text html="{{ page.body_html }}" /></div>
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Content page",
      "ar": "صفحة محتوى"
    },
    "version": 1,
    "templates": ["page"],
    "settings": {
      "show_title": {
        "type": "boolean",
        "label": {
          "en": "Show the title",
          "ar": "إظهار العنوان"
        },
        "default": true
      },
      "width": {
        "type": "select",
        "label": {
          "en": "Width",
          "ar": "العرض"
        },
        "default": "normal",
        "options": ["narrow", "normal", "wide"]
      },
      "align": {
        "type": "select",
        "label": {
          "en": "Text alignment",
          "ar": "محاذاة النص"
        },
        "default": "start",
        "options": ["start", "center"]
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "default": 32,
        "min": 0,
        "max": 120,
        "step": 4
      }
    }
  }
</hk-schema>
