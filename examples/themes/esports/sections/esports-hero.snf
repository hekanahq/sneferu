<hk-section padding-y="24" mobile-padding-y="12" class="es-hero-wrap">
  <div class="es-hero">
    <div class="es-hero-copy">
      <hk-heading
        text="{{ section.settings.title }}"
        level="h1"
        size="56"
        tablet-size="44"
        mobile-size="28"
        class="es-hero-title"
      />
      <hk-text text="{{ section.settings.subtitle }}" size="20" mobile-size="14" class="es-hero-sub" />
      <hk-button label="{{ section.settings.button }}" href="{{ section.settings.button_link }}" class="es-cta" />
      <div class="es-social-list es-hero-social">
        {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
      </div>
    </div>
    <div class="es-hero-art">
      {% if section.settings.art_image %}
        <hk-image src="{{ section.settings.art_image }}" alt="" class="es-art-image" />
      {% else %}
        {% render 'hero-art' %}
      {% endif %}
    </div>
    {% if section.settings.show_offer %}
      <div class="es-offer">
        <span class="es-offer-top">{{ t('offer_top') }}</span>
        <strong class="es-offer-num">{{ section.settings.offer_percent }}%</strong>
        <span class="es-offer-bottom">{{ t('offer_bottom') }}</span>
      </div>
    {% endif %}
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Esports hero",
      "ar": "هيرو الإسبورتس"
    },
    "version": 1,
    "blocks": {
      "allowed": ["social-link"],
      "max": 5
    },
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Title",
          "ar": "العنوان"
        },
        "default": {
          "ar": "اشحن دلوقتي",
          "en": "Top up now"
        },
        "localized": true,
        "maxLength": 40
      },
      "subtitle": {
        "type": "text",
        "label": {
          "en": "Subtitle",
          "ar": "العنوان الفرعي"
        },
        "default": {
          "ar": "خصومات على باقات مختارة من ألعابك",
          "en": "Discounts on selected packs for your games"
        },
        "localized": true,
        "maxLength": 80
      },
      "button": {
        "type": "text",
        "label": {
          "en": "Button",
          "ar": "الزر"
        },
        "default": {
          "ar": "اشحن دلوقتي",
          "en": "Top up now"
        },
        "localized": true,
        "maxLength": 24
      },
      "button_link": {
        "type": "link",
        "label": {
          "en": "Button link",
          "ar": "رابط الزر"
        },
        "default": "/products"
      },
      "art_image": {
        "type": "image",
        "label": {
          "en": "Hero picture (the drawn figures show when empty)",
          "ar": "صورة الهيرو (الشخصيات المرسومة بتظهر لو فاضي)"
        },
        "default": ""
      },
      "show_offer": {
        "type": "boolean",
        "label": {
          "en": "Show the offer box",
          "ar": "إظهار صندوق العرض"
        },
        "default": true
      },
      "offer_percent": {
        "type": "number",
        "label": {
          "en": "Offer percent",
          "ar": "نسبة العرض"
        },
        "default": 20,
        "min": 1,
        "max": 90
      }
    }
  }
</hk-schema>
