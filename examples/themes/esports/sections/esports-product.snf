<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="24">
  {% if section.settings.show_breadcrumb %}
    <nav class="es-breadcrumb" aria-label="{{ t('breadcrumb') }}">
      <a href="{{ url('/') }}">{{ t('home') }}</a>
      {% if product.category %}
        <span aria-hidden="true">/</span>
        <a href="{{ product.category.url }}">{{ product.category.title }}</a>
      {% endif %}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>
  {% endif %}
  <div class="es-product es-gallery-{{ section.settings.gallery_side }} es-sticky-{{ section.settings.sticky_info }}">
    <div class="es-product-gallery es-panel">
      <hk-product-gallery product="{{ product }}" layout="{{ section.settings.gallery_layout }}" />
    </div>
    <div class="es-product-info es-panel" role="group" aria-label="{{ t('product_info') }}">
      {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
    </div>
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Product",
      "ar": "صفحة المنتج"
    },
    "version": 1,
    "templates": ["product"],
    "blocks": {
      "allowed": [
        "product-title",
        "product-price",
        "product-excerpt",
        "product-variants",
        "product-buy",
        "product-description",
        "product-tags",
        "product-category",
        "product-text"
      ],
      "max": 20
    },
    "settings": {
      "gallery_layout": {
        "type": "select",
        "label": {
          "en": "Gallery layout",
          "ar": "شكل المعرض"
        },
        "default": "thumbs-below",
        "options": ["thumbs-below", "thumbs-side", "stacked"]
      },
      "gallery_side": {
        "type": "select",
        "label": {
          "en": "Gallery side",
          "ar": "مكان المعرض"
        },
        "default": "start",
        "options": ["start", "end"]
      },
      "sticky_info": {
        "type": "boolean",
        "label": {
          "en": "Keep the details in view while scrolling",
          "ar": "تثبيت التفاصيل أثناء التمرير"
        },
        "default": true
      },
      "show_breadcrumb": {
        "type": "boolean",
        "label": {
          "en": "Show the breadcrumb",
          "ar": "إظهار مسار الصفحة"
        },
        "default": true
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "default": 32,
        "min": 0,
        "max": 120,
        "step": 4
      }
    }
  }
</hk-schema>
