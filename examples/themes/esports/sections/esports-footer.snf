<footer class="es-footer">
  <hk-container>
    <div class="es-footer-row">
      <div class="es-footer-brand">
        <span class="es-logo">{% render 'mark' %}<span>{{ store.name }}</span></span>
        <p>{{ t('footer_about') }}</p>
      </div>
      <nav class="es-footer-links" aria-label="{{ t('footer_links') }}">
        {% if menu(section.settings.menu).items %}{% for item in menu(section.settings.menu).items %}<a
              href="{{ item.url }}"
              aria-current="{{ item.active }}"
            >{{ item.title }}</a>{% endfor %}{% else %}<a href="{{ url('/products') }}">{{ t('nav_all') }}</a>
          <a href="{{ url('/category/game-currency') }}">{{ t('cat_currency') }}</a>
          <a href="{{ url('/category/gift-cards') }}">{{ t('cat_gift_cards') }}</a>
          <a href="{{ url('/') }}#faq">{{ t('nav_faq') }}</a>{% endif %}
      </nav>
    </div>
    <p class="es-copy">© {{ store.name }}</p>
  </hk-container>
</footer>
<hk-schema>
  {
    "name": "Footer",
    "version": 1,
    "templates": ["footer"],
    "settings": {
      "menu": {
        "type": "menu",
        "label": "Footer menu",
        "default": "footer"
      }
    }
  }
</hk-schema>
