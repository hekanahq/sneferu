<hk-section padding-y="48" mobile-padding-y="32" class="es-steps">
  <hk-stack gap="24">
    <hk-heading text="{{ section.settings.heading }}" level="h2" size="32" mobile-size="22" class="es-h2" />
    <div class="es-step-list">
      {% for block in section.blocks %}
        <hk-block of="{{ block }}" />
      {% endfor %}
    </div>
  </hk-stack>
</hk-section>
<hk-schema>
  {
    "name": "How to redeem",
    "version": 1,
    "settings": {
      "heading": {
        "type": "text",
        "label": "Heading",
        "localized": true,
        "default": {
          "ar": "إزاي تستلم الكود",
          "en": "How you get your code"
        },
        "maxLength": 60
      }
    },
    "blocks": {
      "allowed": ["step"],
      "max": 4
    }
  }
</hk-schema>
