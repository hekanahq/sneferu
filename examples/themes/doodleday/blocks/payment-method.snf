<span class="sf-payment">
  <hk-icon name="{{ block.settings.icon }}" />
  <span>{{ block.settings.label }}</span>
</span>
<hk-schema>
  {
    "name": {
      "en": "Payment method",
      "ar": "طريقة دفع"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Name",
          "ar": "الاسم"
        },
        "default": {
          "ar": "كارت بنكي",
          "en": "Bank card"
        },
        "localized": true,
        "maxLength": 30
      },
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["credit-card", "banknote", "wallet", "smartphone"],
        "default": "credit-card"
      }
    }
  }
</hk-schema>
