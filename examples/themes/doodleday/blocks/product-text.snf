<p class="sf-note sf-note-{{ block.settings.tone }}">
  {% if block.settings.icon != 'none' %}<hk-icon name="{{ block.settings.icon }}" />{% endif %}
  <span>{{ block.settings.text | default: t('product_note') }}</span>
</p>
<hk-schema>
  {
    "name": {
      "en": "Text note",
      "ar": "ملاحظة"
    },
    "version": 1,
    "settings": {
      "text": {
        "type": "textarea",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "default": "",
        "localized": true,
        "maxLength": 200
      },
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["none", "truck", "package", "shield-check", "clock", "gift", "lock", "mail"],
        "default": "mail"
      },
      "tone": {
        "type": "select",
        "label": {
          "en": "Look",
          "ar": "الشكل"
        },
        "options": ["plain", "muted"],
        "default": "muted"
      }
    }
  }
</hk-schema>
