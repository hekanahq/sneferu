<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="16">
  <hk-container max-width="1280">
    <ul class="wk-tiles">
      {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
    </ul>
  </hk-container>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Category tiles",
      "ar": "مربعات الأقسام"
    },
    "version": 1,
    "templates": ["index"],
    "blocks": {
      "allowed": ["tile"],
      "max": 8
    },
    "settings": {
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 120,
        "step": 8,
        "default": 24
      }
    },
    "presets": [
      {
        "name": {
          "en": "Four tiles",
          "ar": "أربعة مربعات"
        },
        "blocks": [
          {
            "type": "tile"
          },
          {
            "type": "tile"
          },
          {
            "type": "tile"
          },
          {
            "type": "tile"
          }
        ]
      }
    ]
  }
</hk-schema>
