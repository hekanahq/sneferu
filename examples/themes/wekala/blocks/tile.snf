<li class="wk-tile-item">
  <a class="wk-tile-link" href="{{ url(block.settings.url) }}">
    <span class="wk-tile-photo">
      {% if block.settings.image %}<img
          src="{{ block.settings.image }}"
          alt="{{ block.settings.label }}"
          width="200"
          height="200"
          loading="lazy"
        >{% endif %}
    </span>
    <span class="wk-tile-label">{{ block.settings.label }}</span>
  </a>
</li>
<hk-schema>
  {
    "name": {
      "en": "Category tile",
      "ar": "مربع قسم"
    },
    "version": 1,
    "settings": {
      "image": {
        "type": "image",
        "label": {
          "en": "Photo",
          "ar": "الصورة"
        },
        "default": ""
      },
      "label": {
        "type": "text",
        "label": {
          "en": "Label",
          "ar": "النص"
        },
        "localized": true,
        "default": {
          "ar": "قسم",
          "en": "Category"
        },
        "maxLength": 30
      },
      "url": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/products"
      }
    }
  }
</hk-schema>
