<li class="bk-trust-item">
  <span class="bk-trust-icon"><hk-icon name="{{ block.settings.icon }}" class="ic" /></span>
  <span>{{ block.settings.label }}</span>
</li>
<hk-schema>
  {
    "name": {
      "en": "Trust point",
      "ar": "نقطة ثقة"
    },
    "version": 1,
    "settings": {
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["banknote", "truck", "package", "shield-check", "gift", "star", "heart", "credit-card"],
        "default": "banknote"
      },
      "label": {
        "type": "text",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "localized": true,
        "default": {
          "ar": "الدفع عند الاستلام",
          "en": "Cash on delivery"
        },
        "maxLength": 60
      }
    }
  }
</hk-schema>
