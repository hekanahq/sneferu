<article class="st-card st-card-{{ card_style }}">
  <a class="st-card-link" href="{{ product.url }}">
    <div class="st-card-media">
      <hk-image
        src="{{ product.image }}"
        alt="{{ product.title }}"
        aspect-ratio="{{ image_ratio }}"
        sizes="(min-width: 1024px) 25vw, 50vw"
      />
      {% if show_badge %}
        {% if product.available %}
          {% if product.compare_at > product.price %}
            <span class="st-badge">{{ t('sale') }}</span>
          {% endif %}
        {% else %}
          <span class="st-badge st-badge-muted">{{ t('sold_out_badge') }}</span>
        {% endif %}
      {% endif %}
    </div>
    <h3 class="st-card-title">{{ product.title }}</h3>
    {% if product.options %}
      <ul class="st-sizes">
        {% for option in product.options limit: 1 %}{% for value in option.values limit: 5 %}
            <li class="st-size">{{ value }}</li>
          {% endfor %}{% endfor %}
      </ul>
    {% endif %}
    {% if show_price %}{% render 'price', product: product, bind: false %}{% endif %}
    {% if note %}<span class="st-card-note">{{ note }}</span>{% endif %}
    <span class="st-card-cta">{{ t('choose_options') }}</span>
  </a>
</article>
