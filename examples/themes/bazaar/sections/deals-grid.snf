{% if collection(section.settings.collection).products %}
  <hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="16">
    <hk-container max-width="1280">
      <div class="bz-row-head">
        {% if section.settings.title %}
          <h2 class="bz-grid-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.link_label %}
          <a class="bz-more" href="{{ url(section.settings.link) }}">{{ section.settings.link_label }}</a>
        {% endif %}
      </div>
      <div class="bz-grid bz-cols-{{ section.settings.columns }}">
        {% for p in collection(section.settings.collection).products limit: section.settings.limit %}
          {% render 'product-card', product: p, card_style: 'bordered', image_ratio: '1/1', show_price: true, show_badge: true %}
        {% endfor %}
      </div>
    </hk-container>
  </hk-section>
{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Deals grid",
      "ar": "شبكة العروض"
    },
    "version": 1,
    "templates": ["index", "page"],
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Heading",
          "ar": "العنوان"
        },
        "localized": true,
        "default": {
          "ar": "عروض مختارة",
          "en": "Selected deals"
        },
        "maxLength": 60
      },
      "collection": {
        "type": "collection",
        "label": {
          "en": "Collection",
          "ar": "القسم"
        },
        "default": "featured"
      },
      "limit": {
        "type": "range",
        "label": {
          "en": "Number of products",
          "ar": "عدد المنتجات"
        },
        "min": 2,
        "max": 30,
        "step": 1,
        "default": 10
      },
      "columns": {
        "type": "range",
        "label": {
          "en": "Columns",
          "ar": "الأعمدة"
        },
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 5
      },
      "link_label": {
        "type": "text",
        "label": {
          "en": "Link label",
          "ar": "نص الرابط"
        },
        "localized": true,
        "default": {
          "ar": "عرض الكل",
          "en": "View all"
        },
        "maxLength": 30
      },
      "link": {
        "type": "link",
        "label": {
          "en": "Link",
          "ar": "الرابط"
        },
        "default": "/products"
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 120,
        "step": 8,
        "default": 24
      }
    }
  }
</hk-schema>
