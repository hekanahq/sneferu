<svg
  class="tw-glyph"
  viewBox="0 0 24 24"
  width="22"
  height="22"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {% if name == 'leaf' %}<path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 15" /><path d="M5 19c3-5 6-8 10-10" />
  {% elsif name == 'milk' %}<path d="M8 3h8l1 4v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V7l1-4z" /><path d="M7 7h10M7 12h10" />
  {% elsif name == 'jar' %}<path d="M8 3h8v3H8z" /><path
      d="M7 6h10a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"
    /><path d="M9 12h6" />
  {% elsif name == 'cup' %}<path d="M5 7h12v7a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5V7z" /><path d="M17 9h2a2 2 0 0 1 0 5h-2" /><path
