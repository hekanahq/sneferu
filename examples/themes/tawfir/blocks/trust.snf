<div class="tw-trust-item">
  <span class="tw-trust-icon">{% render 'icon', name: block.settings.icon %}</span>
  <span
    class="tw-trust-text"
  ><strong>{{ block.settings.label }}</strong>{% if block.settings.text %}<small>{{ block.settings.text }}</small>{% endif %}</span>
</div>
<hk-schema>
  {
    "name": {
      "en": "Trust point",
      "ar": "نقطة ثقة"
    },
    "version": 1,
    "settings": {
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": [
          "percent",
          "leaf",
          "milk",
          "jar",
          "cup",
          "spray",
          "tag",
          "truck",
          "banknote",
          "shield-check",
          "package",
          "store",
          "heart",
          "gift",
          "star",
          "home",
          "zap",
          "flame"
        ],
        "default": "truck"
      },
      "label": {
        "type": "text",
        "label": {
          "en": "Title",
          "ar": "العنوان"
        },
        "default": {
          "ar": "توصيل",
          "en": "Delivery"
        },
        "maxLength": 30,
        "localized": true
      },
      "text": {
        "type": "text",
        "label": {
          "en": "Small line",
          "ar": "السطر الصغير"
        },
        "default": {
          "ar": "لكل المحافظات",
          "en": "Across Egypt"
        },
        "maxLength": 50,
        "localized": true
      }
    }
  }
</hk-schema>
