<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="16">
  {% if section.settings.show_breadcrumb %}
    <nav class="tw-breadcrumb" aria-label="{{ t('breadcrumb') }}">
      <a href="{{ url('/') }}">{{ t('home') }}</a>
      {% if product.category %}<span aria-hidden="true">/</span><a
          href="{{ product.category.url }}"
        >{{ product.category.title }}</a>{% endif %}
      <span aria-hidden="true">/</span><span aria-current="page">{{ product.title }}</span>
    </nav>
  {% endif %}
  <div class="tw-product">
    <div class="tw-product-gallery">
      <hk-product-gallery product="{{ product }}" layout="{{ section.settings.gallery_layout }}" />
    </div>
    <div class="tw-product-info" role="group" aria-label="{{ t('product_info') }}">
      <h1 class="tw-product-title">{{ product.title }}</h1>
      <div class="tw-product-price">
        <hk-price amount="{{ product.price }}" compare-at="{{ product.compare_at }}" product="{{ product }}" />
        {% if section.settings.show_offer %}{% if product.compare_at > product.price %}<span
              class="tw-badge tw-badge-inline"
            >{{ t('offer') }}</span>{% endif %}{% endif %}
      </div>
      {% if product.excerpt %}
        <p class="tw-muted">{{ product.excerpt }}</p>
      {% endif %}
      <hk-variant-picker product="{{ product }}" />
      <hk-add-to-cart product="{{ product }}" label="{{ section.settings.buy_label }}" />
      {% if section.blocks %}
        <ul class="tw-notes">
          {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
        </ul>
      {% endif %}
      {% if product.description %}
        <div class="tw-product-desc"><hk-rich-text html="{{ product.description }}" /></div>
      {% endif %}
    </div>
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Product",
      "ar": "المنتج"
    },
    "version": 1,
    "templates": ["product"],
    "blocks": {
      "allowed": ["product-note"],
      "max": 5
    },
    "settings": {
      "gallery_layout": {
        "type": "select",
        "label": {
          "en": "Gallery layout",
          "ar": "شكل المعرض"
        },
        "options": ["thumbs-below", "thumbs-side", "stacked"],
        "default": "thumbs-below"
      },
      "show_breadcrumb": {
        "type": "boolean",
        "label": {
          "en": "Show breadcrumb",
          "ar": "إظهار مسار الصفحة"
        },
        "default": true
      },
      "show_offer": {
        "type": "boolean",
        "label": {
          "en": "Show the offer badge when a compare-at price exists",
          "ar": "إظهار شارة العرض عند وجود سعر قبل الخصم"
        },
        "default": true
      },
      "buy_label": {
        "type": "text",
        "label": {
          "en": "Add to cart label (default: Add to cart)",
          "ar": "نص زر الإضافة (الافتراضي: أضف للسلة)"
        },
        "default": {
          "ar": "",
          "en": ""
        },
        "maxLength": 30,
        "localized": true
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 120,
        "step": 8,
        "default": 24
      }
    }
  }
</hk-schema>
