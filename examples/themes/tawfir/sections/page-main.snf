<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="16">
  <div class="tw-page">
    {% if section.settings.show_title %}
      <h1 class="tw-h1">{{ page.title }}</h1>
    {% endif %}
    <hk-rich-text html="{{ page.body_html }}" />
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Page content",
      "ar": "محتوى الصفحة"
    },
    "version": 1,
    "templates": ["page"],
    "settings": {
      "show_title": {
        "type": "boolean",
        "label": {
          "en": "Show title",
          "ar": "إظهار العنوان"
        },
        "default": true
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 120,
        "step": 8,
        "default": 24
      }
    }
  }
</hk-schema>
