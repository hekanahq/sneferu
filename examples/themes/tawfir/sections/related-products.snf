{% if collection('related').products %}
  <hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="16">
    <h2 class="tw-h2">{{ section.settings.title }}</h2>
    <div class="tw-grid tw-cols-{{ section.settings.columns }}">
      {% for p in collection('related').products limit: section.settings.limit %}{% render 'product-card', product: p %}{% endfor %}
    </div>
  </hk-section>
{% else %}{% if collection(section.settings.collection).products %}
    <hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="16">
      <h2 class="tw-h2">{{ section.settings.title }}</h2>
      <div class="tw-grid tw-cols-{{ section.settings.columns }}">
        {% for p in collection(section.settings.collection).products limit: 8 %}{% if p.handle != product.handle %}{% render 'product-card', product: p %}{% endif %}{% endfor %}
      </div>
    </hk-section>
  {% endif %}{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Related products",
      "ar": "منتجات مشابهة"
    },
    "version": 1,
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Heading",
          "ar": "العنوان"
        },
        "default": {
          "ar": "المزيد من نفس القسم",
          "en": "More from this aisle"
        },
        "maxLength": 50,
        "localized": true
      },
      "collection": {
        "type": "collection",
        "label": {
          "en": "Fallback collection",
          "ar": "القسم الاحتياطي"
        },
        "default": "featured"
      },
      "limit": {
        "type": "range",
        "label": {
          "en": "Products",
          "ar": "عدد المنتجات"
        },
        "min": 5,
        "max": 10,
        "step": 1,
        "default": 5
      },
      "columns": {
        "type": "select",
        "label": {
          "en": "Columns",
          "ar": "الأعمدة"
        },
        "options": ["4", "5", "6"],
        "default": "5"
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 120,
        "step": 8,
        "default": 24
      }
    }
  }
</hk-schema>
