{
  "id": "onyx",
  "name": "Onyx",
  "version": "1.0.2",
  "author": "Hekana",
  "description": "A cinematic black store for perfumes, watches and fine accessories: champagne-gold hairlines, a wide hero, large outlined category pills, flat image tiles and a gold-ringed trust strip, on every page.",
  "category": "luxury",
  "engine": "hk2",
  "engineCompatibility": "^2.0.0",
  "defaultLocale": "ar",
  "locales": ["ar", "en"],
  "settings": {},
  "tokens": {
    "colors": {
      "primary": "#D4B483",
      "secondary": "#14110D",
      "accent": "#D4B483",
      "background": "#0A0908",
      "text": "#F2EBDD",
      "muted": "#A89F90",
      "line": "#3B3226",
      "soft": "#17140F",
      "surface": "#110F0C",
      "glow": "#2A2216"
    },
    "layout": {
      "contentWidth": "1200px"
    },
    "fonts": {
      "heading": "Tajawal",
      "body": "IBM Plex Sans Arabic"
    },
    "radius": {
      "md": "4px"
    }
  },
  "money": {
    "format": "whole"
  }
}
