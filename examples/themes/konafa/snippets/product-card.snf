<article class="kn-card kn-card-{{ card_style }}">
  <a class="kn-card-link" href="{{ product.url }}">
    <div class="kn-card-media">
      <hk-image
        src="{{ product.image }}"
        alt="{{ product.title }}"
        aspect-ratio="{{ image_ratio }}"
        sizes="(min-width: 1024px) 25vw, 50vw"
      />
      {% if show_badge %}
        {% if product.available %}
          {% if product.compare_at > product.price %}
            <span class="kn-badge">{{ t('sale') }}</span>
          {% endif %}
        {% else %}
          <span class="kn-badge kn-badge-muted">{{ t('sold_out_badge') }}</span>
        {% endif %}
      {% endif %}
    </div>
    <div class="kn-card-row">
      <h3 class="kn-card-title">{{ product.title }}</h3>
      {% if show_price %}{% render 'price', product: product, bind: false %}{% endif %}
    </div>
    <span class="kn-card-cta">{{ t('view_product') }}</span>
  </a>
</article>
