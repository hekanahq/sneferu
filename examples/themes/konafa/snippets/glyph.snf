<svg
  class="ic ic-{{ name }}"
  viewBox="0 0 48 48"
  width="44"
  height="44"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {% if name == 'crescent' %}<path d="M30 7a17 17 0 1 0 11 29A14 14 0 0 1 30 7z" /><path
      d="M36 10l1.4 3.2 3.2 1.4-3.2 1.4L36 19.2l-1.4-3.2-3.2-1.4 3.2-1.4z"
    />
  {% elsif name == 'star8' %}<path d="M10 10h28v28H10z" /><path d="M10 10h28v28H10z" transform="rotate(45 24 24)" /><circle
      cx="24"
      cy="24"
      r="6"
    />
  {% elsif name == 'box' %}<path d="M7 18h34v6H7z" /><path d="M10 24v16h28V24" /><path d="M24 18v22" /><path
      d="M24 18c-5 0-9-1-9-4.5S19 9 24 18c5-9 9-8.5 9-4.5S29 18 24 18z"
    />
  {% endif %}
</svg>
