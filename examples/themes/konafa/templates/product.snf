<hk-sections />
<hk-schema>
  {
    "sections": [
      {
        "type": "product-main",
        "blocks": [
          {
            "type": "product-title"
          },
          {
            "type": "product-price"
          },
          {
            "type": "product-excerpt"
          },
          {
            "type": "product-variants"
          },
          {
            "type": "product-buy"
          },
          {
            "type": "product-text"
          },
          {
            "type": "product-text",
            "settings": {
              "icon": "package",
              "text": {
                "ar": "يُحفظ في مكان بارد وجاف بعيدًا عن الشمس.",
                "en": "Keep in a cool, dry place away from sunlight."
              },
              "tone": "plain"
            }
          },
          {
            "type": "product-description"
          },
          {
            "type": "product-tags"
          }
        ]
      },
      {
        "type": "kn-trust",
        "blocks": [
          {
            "type": "trust",
            "settings": {
              "icon": "banknote",
              "label": {
                "ar": "الدفع عند الاستلام",
                "en": "Cash on delivery"
              }
            }
          },
          {
            "type": "trust",
            "settings": {
              "icon": "truck",
              "label": {
                "ar": "توصيل لكل المحافظات",
                "en": "Delivery across Egypt"
              }
            }
          },
          {
            "type": "trust",
            "settings": {
              "icon": "gift",
              "label": {
                "ar": "تغليف مناسب للهدايا",
                "en": "Gift-ready packing"
              }
            }
          }
        ]
      },
      {
        "type": "related-products",
        "settings": {
          "collection": "featured"
        }
      }
    ]
  }
</hk-schema>
