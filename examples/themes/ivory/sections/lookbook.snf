<hk-section padding-y="{{ section.settings.padding_y }}" mobile-padding-y="32">
  {% if section.settings.title %}
    <div class="iv-section-title">
      <hk-heading text="{{ section.settings.title }}" level="h2" size="28" mobile-size="22" align="center" />
    </div>
  {% endif %}
  <div class="iv-lookbook">
    {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "en": "Lookbook",
      "ar": "اللوك بوك"
    },
    "version": 1,
    "templates": ["index"],
    "blocks": {
      "allowed": ["look"],
      "max": 3
    },
    "settings": {
      "title": {
        "type": "text",
        "label": {
          "en": "Heading",
          "ar": "العنوان"
        },
        "localized": true,
        "default": {
          "en": "The lookbook",
          "ar": "اللوك بوك"
        },
        "maxLength": 60
      },
      "padding_y": {
        "type": "range",
        "label": {
          "en": "Vertical padding",
          "ar": "المسافة الرأسية"
        },
        "min": 0,
        "max": 160,
        "step": 8,
        "default": 56
      }
    }
  }
</hk-schema>
