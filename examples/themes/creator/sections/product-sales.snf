<section class="cr-sec cr-pad-{{ section.settings.padding_y }}">
  <div class="cr-wrap">
    {% if section.settings.show_breadcrumb %}
      <nav class="cr-crumb" aria-label="{{ t('breadcrumb') }}">
        <a href="{{ url('/') }}">{{ t('home') }}</a>
        {% if product.category %}<span aria-hidden="true">/</span><a
            href="{{ product.category.url }}"
          >{{ product.category.title }}</a>{% endif %}
      </nav>
    {% endif %}
    <div class="cr-sales-cover">
      <hk-product-gallery product="{{ product }}" layout="stacked" />
      {% if section.settings.badge %}<span class="cr-flag">{{ section.settings.badge }}</span>{% endif %}
    </div>
    <div class="cr-sales">
      <div class="cr-sales-main">
        {% for block in section.blocks %}{% if block.type == 'product-description' or block.type == 'block-title' or block.type == 'get-item' or block.type == 'product-tags' or block.type == 'product-excerpt' %}<hk-block
              of="{{ block }}"
            />{% endif %}{% endfor %}
      </div>
      <aside class="cr-buybox" aria-label="{{ t('product_info') }}">
        {% for block in section.blocks %}{% if block.type == 'product-title' or block.type == 'product-price' or block.type == 'product-variants' or block.type == 'product-buy' or block.type == 'product-category' or block.type == 'note' %}<hk-block
              of="{{ block }}"
            />{% endif %}{% endfor %}
      </aside>
    </div>
  </div>
</section>
<hk-schema>
  {
    "name": {
      "en": "Product, sales page",
      "ar": "المنتج: صفحة بيع"
    },
    "version": 1,
    "templates": ["product.digital"],
    "blocks": {
      "allowed": [
        "product-title",
        "product-price",
        "product-excerpt",
        "product-variants",
        "product-buy",
        "product-description",
        "product-tags",
        "product-category",
        "note",
        "block-title",
        "get-item"
      ],
      "max": 20
    },
    "settings": {
      "badge": {
        "type": "text",
        "label": {
          "en": "Badge on the cover",
          "ar": "الشارة على الغلاف"
        },
        "default": {
          "ar": "وصول فوري",
          "en": "Instant access"
        },
        "localized": true,
        "maxLength": 30
      },
      "show_breadcrumb": {
        "type": "boolean",
        "label": {
          "en": "Show breadcrumb",
          "ar": "إظهار مسار الصفحة"
        },
        "default": true
      },
      "padding_y": {
        "type": "select",
        "label": {
          "en": "Vertical spacing",
          "ar": "المسافة الرأسية"
        },
        "options": ["compact", "normal", "roomy"],
        "default": "normal"
      }
    }
  }
</hk-schema>
