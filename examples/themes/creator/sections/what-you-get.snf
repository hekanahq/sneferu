<section class="cr-what" id="what">
  <div class="cr-wrap">
    <h2 class="cr-h2">{{ section.settings.heading }}</h2>
    <div class="cr-list">
      {% for block in section.blocks %}
        <hk-block of="{{ block }}" />
      {% endfor %}
    </div>
  </div>
</section>
<hk-schema>
  {
    "name": "What you get",
    "version": 1,
    "settings": {
      "heading": {
        "type": "text",
        "label": "Heading",
        "localized": true,
        "default": {
          "ar": "هتاخد إيه مع كل منتج",
          "en": "What you get with every product"
        },
        "maxLength": 80
      }
    },
    "blocks": {
      "allowed": ["get-item"],
      "max": 8
    }
  }
</hk-schema>
