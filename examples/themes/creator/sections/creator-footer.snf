<footer class="cr-footer">
  <div class="cr-wrap cr-footer-row">
    <p class="cr-footer-name">{{ store.name }}</p>
    <p class="cr-footer-note">{{ t('footer_note') }}</p>
    <hk-locale-switch class="cr-footer-locale" />{% if menu(section.settings.menu).items %}
      <nav class="cr-footer-links" aria-label="{{ t('menu') }}">
        {% for item in menu(section.settings.menu).items %}<a
            href="{{ item.url }}"
            aria-current="{{ item.active }}"
          >{{ item.title }}</a>{% endfor %}
      </nav>
    {% endif %}
  </div>
</footer>
<hk-schema>
  {
    "name": "Footer",
    "version": 1,
    "templates": ["footer"],
    "settings": {
      "menu": {
        "type": "menu",
        "label": "Footer menu",
        "default": "footer"
      }
    }
  }
</hk-schema>
