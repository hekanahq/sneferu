{
  "id": "creator",
  "name": "Creator",
  "version": "2.0.2",
  "author": "Hekana",
  "description": "A complete editorial store for one creator selling courses, e-books and templates: warm paper, black type, one orange accent, and its own product, collection, cart, search, 404 and page designs.",
  "category": "digital",
  "engine": "hk2",
  "engineCompatibility": "^2.0.0",
  "defaultLocale": "ar",
  "locales": ["ar", "en"],
  "settings": {},
  "tokens": {
    "colors": {
      "primary": "#151515",
      "secondary": "#0F1A24",
      "accent": "#B94A1B",
      "background": "#F3F0EA",
      "text": "#151515",
      "muted": "#716B64",
      "surface": "#FBF9F5",
      "line": "#CFC8BE",
      "on-primary": "#F3F0EA",
      "on-accent": "#FFFFFF"
    },
    "layout": { "contentWidth": "1040px" },
    "radius": { "md": "12px" },
    "fonts": {
      "heading": "IBM Plex Sans Arabic",
      "body": "IBM Plex Sans Arabic"
    }
  }
}
