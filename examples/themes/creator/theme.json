{
  "id": "creator",
  "name": "Creator",
  "version": "1.3.0",
  "author": "Hekana",
  "description": "An editorial theme for one creator selling courses, e-books and templates",
  "category": "digital",
  "engine": "hk2",
  "engineCompatibility": "^2.0.0",
  "defaultLocale": "ar",
  "locales": ["ar", "en"],
  "settings": {},
  "tokens": {
    "colors": {
      "primary": "#151515",
      "secondary": "#0F1A24",
      "accent": "#B94A1B",
      "background": "#F3F0EA",
      "text": "#151515",
      "muted": "#716B64",
      "line": "#CFC8BE",
      "on-accent": "#FFFFFF"
    },
    "layout": { "contentWidth": "1040px" },
    "fonts": {
      "heading": "IBM Plex Sans Arabic",
      "body": "IBM Plex Sans Arabic"
    }
  }
}
