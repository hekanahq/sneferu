<article class="cr-cover" id="{{ slot }}-{{ forloop.index }}">
  <hk-product-card product="{{ p }}" class="cr-card">
    <hk-part name="badge">
      <span class="cr-flag">{{ section.settings.badge }}</span>
      <span class="cr-kind">{{ kind }}</span>
    </hk-part>
  </hk-product-card>
</article>
