<hk-add-to-cart
  product="{{ product }}"
  label="{{ block.settings.label }}"
  sold-out-label="{{ block.settings.sold_out_label }}"
  quantity="{{ block.settings.show_quantity }}"
  variant="{{ block.settings.button_style }}"
/>
<hk-schema>
  {
    "name": {
      "en": "Buy button",
      "ar": "زر الشراء"
    },
    "version": 1,
    "settings": {
      "label": {
        "type": "text",
        "label": {
          "en": "Button text (default: the store's)",
          "ar": "نص الزر (الافتراضي بتاع المتجر)"
        },
        "default": "",
        "localized": true,
        "maxLength": 30
      },
      "sold_out_label": {
        "type": "text",
        "label": {
          "en": "Sold out text",
          "ar": "نص خلص"
        },
        "default": "",
        "localized": true,
        "maxLength": 30
      },
      "show_quantity": {
        "type": "boolean",
        "label": {
          "en": "Show quantity",
          "ar": "إظهار الكمية"
        },
        "default": false
      },
      "button_style": {
        "type": "select",
        "label": {
          "en": "Style",
          "ar": "الشكل"
        },
        "options": ["solid", "outline"],
        "default": "solid"
      }
    }
  }
</hk-schema>
