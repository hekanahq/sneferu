{% render 'list-item', term: block.settings.term, text: block.settings.text %}
<hk-schema>
  {
    "name": {
      "en": "What you get: item",
      "ar": "هتاخد إيه: بند"
    },
    "version": 1,
    "settings": {
      "term": {
        "type": "text",
        "label": {
          "en": "Item",
          "ar": "البند"
        },
        "default": {
          "ar": "الدروس",
          "en": "Lessons"
        },
        "localized": true,
        "maxLength": 40
      },
      "text": {
        "type": "text",
        "label": {
          "en": "Detail",
          "ar": "التفصيل"
        },
        "default": {
          "ar": "فيديوهات مسجّلة تتفرج عليها في الوقت اللي يناسبك",
          "en": "Recorded videos you watch when it suits you"
        },
        "localized": true,
        "maxLength": 120
      }
    }
  }
</hk-schema>
