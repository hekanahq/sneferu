{% if block.settings.text %}
  <p class="cr-note">
    {% if block.settings.icon != 'none' %}<hk-icon name="{{ block.settings.icon }}" size="20" />{% endif %}<span>{{ block.settings.text }}</span>
  </p>
{% endif %}
<hk-schema>
  {
    "name": {
      "en": "Note",
      "ar": "ملاحظة"
    },
    "version": 1,
    "settings": {
      "text": {
        "type": "textarea",
        "label": {
          "en": "Text",
          "ar": "النص"
        },
        "default": {
          "ar": "رابط التحميل بيوصلك على الإيميل بعد الدفع أونلاين.",
          "en": "Your download link is emailed after online payment."
        },
        "localized": true,
        "maxLength": 200
      },
      "icon": {
        "type": "select",
        "label": {
          "en": "Icon",
          "ar": "الأيقونة"
        },
        "options": ["none", "download", "mail", "shield-check", "clock", "gift", "lock", "file-text"],
        "default": "download"
      }
    }
  }
</hk-schema>
