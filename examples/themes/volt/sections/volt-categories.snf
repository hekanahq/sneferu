<hk-section full-bleed="true" padding-y="0" mobile-padding-y="0" class="vt-cats-section">
  <div class="vt-wide">
    <div class="vt-cats">
      {% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}
    </div>
  </div>
</hk-section>
<hk-schema>
  {
    "name": {
      "ar": "أقسام بالصور",
      "en": "Category tiles"
    },
    "version": 1,
    "settings": {},
    "blocks": {
      "allowed": ["category-tile"],
      "max": 6
    },
    "presets": [
      {
        "name": {
          "ar": "خمسة أقسام",
          "en": "Five tiles"
        },
        "blocks": [
          {
            "type": "category-tile"
          },
          {
            "type": "category-tile"
          },
          {
            "type": "category-tile"
          },
          {
            "type": "category-tile"
          },
          {
            "type": "category-tile"
          }
        ]
      }
    ]
  }
</hk-schema>
