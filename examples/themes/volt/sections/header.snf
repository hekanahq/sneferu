<header class="vt-header vt-scheme-{{ section.settings.scheme }} vt-sticky-{{ section.settings.sticky }}">
  <hk-container>
    <div class="vt-header-bar">
      <a class="vt-logo" href="{{ url('/') }}">
        {% if section.settings.logo %}
          <img
            class="vt-logo-img vt-logo-h-{{ section.settings.logo_height }}"
            src="{{ section.settings.logo }}"
            alt="{{ store.name }}"
            width="160"
            height="{{ section.settings.logo_height }}"
          >
        {% endif %}
        {% if section.settings.logo_text %}
          <span class="vt-logo-text">{{ section.settings.logo_text }}</span>
        {% elsif section.settings.logo == '' %}
          <span class="vt-logo-text">{{ store.name }}</span>
        {% endif %}
      </a>
      {% if section.settings.show_nav %}
        <nav class="vt-nav" aria-label="{{ t('menu') }}">
          {% if menu(section.settings.menu).items %}
            {% for item in menu(section.settings.menu).items %}
              <div class="vt-nav-item">
                <a class="vt-nav-link" href="{{ item.url }}" aria-current="{{ item.active }}">{{ item.title }}</a>
                {% if item.children %}
                  <div class="vt-subnav">
                    {% for sub in item.children %}
                      <a class="vt-subnav-link" href="{{ sub.url }}" aria-current="{{ sub.active }}">{{ sub.title }}</a>
                      {% for leaf in sub.children %}
                        <a
                          class="vt-subnav-link vt-subnav-deep"
                          href="{{ leaf.url }}"
                          aria-current="{{ leaf.active }}"
                        >{{ leaf.title }}</a>
                      {% endfor %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}{% for block in section.blocks %}<hk-block of="{{ block }}" />{% endfor %}{% endif %}
        </nav>
      {% endif %}
      {% if section.settings.show_search %}{% if section.settings.search_style == 'bar' %}
          <div class="vt-search-bar"><hk-search-form placeholder="{{ t('search_placeholder') }}" /></div>
        {% endif %}{% endif %}
      <div class="vt-header-actions">
        {% if section.settings.show_search %}{% if section.settings.search_style == 'icon' %}
            <details class="vt-search-toggle">
              <summary class="vt-icon-button" aria-label="{{ t('search') }}"><hk-icon name="search" /></summary>
              <div class="vt-search-panel"><hk-search-form placeholder="{{ t('search_placeholder') }}" /></div>
            </details>
          {% endif %}{% endif %}
        {% if section.settings.show_language %}<hk-locale-switch />{% endif %}
        {% if section.settings.show_account %}
          <a class="vt-icon-button" href="{{ url('/account') }}" aria-label="{{ t('account') }}"><hk-icon name="user" /></a>
        {% endif %}
        {% if section.settings.show_cart %}
          <a
            class="vt-icon-button vt-cart-link"
            href="{{ url('/cart') }}"
            data-hk-open="cart-drawer"
            aria-label="{{ t('cart') }}"
          >
            <hk-icon name="shopping-cart" />
            <hk-cart-count />
          </a>
        {% endif %}
      </div>
    </div>
  </hk-container>
  {% if section.settings.show_cart %}
    <hk-cart-drawer open-on-add="{{ section.settings.drawer_on_add }}">
      <hk-cart-items />
      <hk-cart-summary />
    </hk-cart-drawer>
  {% endif %}
</header>
<hk-schema>
  {
    "name": {
      "en": "Header",
      "ar": "الهيدر"
    },
    "version": 1,
    "templates": ["header"],
    "blocks": {
      "allowed": ["menu-link"],
      "max": 8
    },
    "settings": {
      "show_nav": {
        "type": "boolean",
        "label": {
          "en": "Show the menu links in the top bar",
          "ar": "إظهار روابط القائمة في الشريط العلوي"
        },
        "default": true
      },
      "menu": {
        "type": "menu",
        "label": {
          "en": "Menu (the links below show when none is picked or it has no links)",
          "ar": "القائمة (الروابط اللي تحت بتظهر لو مفيش قائمة أو مفيهاش روابط)"
        },
        "default": ""
      },
      "logo": {
        "type": "image",
        "label": {
          "en": "Logo image",
          "ar": "صورة الشعار"
        },
        "default": ""
      },
      "logo_text": {
        "type": "text",
        "label": {
          "en": "Logo text (store name when empty)",
          "ar": "نص الشعار (اسم المتجر لو فاضي)"
        },
        "default": "",
        "localized": true,
        "maxLength": 40
      },
      "logo_height": {
        "type": "select",
        "label": {
          "en": "Logo height (px)",
          "ar": "ارتفاع الشعار (بكسل)"
        },
        "options": ["24", "32", "40", "48", "64"],
        "default": "40"
      },
      "scheme": {
        "type": "select",
        "label": {
          "en": "Colour scheme",
          "ar": "ألوان الهيدر"
        },
        "options": ["light", "primary", "accent"],
        "default": "light"
      },
      "sticky": {
        "type": "boolean",
        "label": {
          "en": "Stick to the top",
          "ar": "تثبيت في أعلى الصفحة"
        },
        "default": false
      },
      "show_search": {
        "type": "boolean",
        "label": {
          "en": "Show search",
          "ar": "إظهار البحث"
        },
        "default": true
      },
      "search_style": {
        "type": "select",
        "label": {
          "en": "Search style",
          "ar": "شكل البحث"
        },
        "options": ["bar", "icon"],
        "default": "bar",
        "visible_if": {
          "setting": "show_search",
          "equals": true
        }
      },
      "show_account": {
        "type": "boolean",
        "label": {
          "en": "Show account icon",
          "ar": "إظهار أيقونة الحساب"
        },
        "default": true
      },
      "show_language": {
        "type": "boolean",
        "label": {
          "en": "Show language switch",
          "ar": "إظهار تبديل اللغة"
        },
        "default": true
      },
      "show_cart": {
        "type": "boolean",
        "label": {
          "en": "Show cart",
          "ar": "إظهار السلة"
        },
        "default": true
      },
      "drawer_on_add": {
        "type": "boolean",
        "label": {
          "en": "Open the cart when an item is added",
          "ar": "فتح السلة عند الإضافة"
        },
        "default": true,
        "visible_if": {
          "setting": "show_cart",
          "equals": true
        }
      }
    }
  }
</hk-schema>
